@implements IDisposable
@inject AddKeyModel Model
@inject ScreenNavigation Nav
@inject IFilePickerService FilePicker
@inject NetworkChoices Choices

@* Design 8: import a typed seed, or open a backup container and choose keys out of it. Generating a
   key is not here -- the Accounts screen's New account does that -- so this screen only brings in
   keys that already exist elsewhere. Every validation and every derivation lives in AddKeyModel; this
   component only routes the two input shapes to Import / SelectContainerKey and shows whatever
   Model.Preview or Model.Problem already says. The one exception design 6 calls for explicitly --
   offering export immediately after a key that exists nowhere else is stored (a backup this
   application wrote for a generated key, opened again), not as a menu item elsewhere -- is handled
   by embedding ExportKey directly below rather than returning to the accounts list first. *@

@if (_unexportedReference is { } reference)
{
    <div class="alert alert-success">
        @T[KeysText.ExportReminder]
    </div>
    <ExportKey Reference="@reference" OnBack="FinishAsync" />
}
else
{
    <BackLink To="AppTab.Accounts" OnClick="FinishAsync" />
    <h1 class="xf-title">@T[KeysText.ImportTitle]</h1>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(Nav.ImportTab == ImportTab.Seed ? "active" : "")" @onclick="() => SwitchMode(ImportTab.Seed)">@T[KeysText.TabSeed]</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(Nav.ImportTab == ImportTab.Backup ? "active" : "")" @onclick="() => SwitchMode(ImportTab.Backup)">@T[KeysText.TabBackup]</button>
        </li>
    </ul>

    @if (Model.Problem is { } problem)
    {
        <div class="alert alert-danger">@T[problem]</div>
    }

    <section class="xf-card">
        @switch (Nav.ImportTab)
        {
            case ImportTab.Seed:
                <div class="mb-3">
                    <label for="add-import-label" class="form-label">@T[CommonText.FieldLabel]</label>
                    <input id="add-import-label" class="form-control" @bind="_label" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mb-3">
                    <label for="add-import-network" class="form-label">@T[CommonText.FieldNetwork]</label>
                    <NetworkSelect Id="add-import-network" @bind-Value="_network" Disabled="_busy" />
                </div>
                <div class="mb-3">
                    <label for="add-import-seed" class="form-label">@T[KeysText.SeedLabel]</label>
                    <input id="add-import-seed" type="password" class="form-control" @bind="_seed" @bind:event="oninput" disabled="@_busy" />
                </div>
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="DoImport">@T[KeysText.PreviewButton]</button>
                break;

            case ImportTab.Backup:
                @if (Model.ContainerKeys.Count == 0)
                {
                    <div class="mb-3">
                        <label for="add-backup-password" class="form-label">@T[KeysText.BackupPasswordOptionalLabel]</label>
                        <input id="add-backup-password" type="password" class="form-control" @bind="_containerPassword" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="PickFileAsync">
                        @T[KeysText.ChooseFileButton]
                    </button>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>@T[KeysText.ColumnAddress]</th>
                                <th>@T[KeysText.ColumnAlgorithm]</th>
                                <th>@T[KeysText.ColumnBackupLabel]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int index = 0; index < Model.ContainerKeys.Count; index++)
                            {
                                ContainerKeyOption key = Model.ContainerKeys[index];
                                int capturedIndex = index;
                                <tr>
                                    <td><code class="xf-mono">@key.Address</code></td>
                                    <td>@key.Algorithm</td>
                                    <td>@(key.Label ?? "—")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                                @onclick="() => BeginSelect(capturedIndex, key)">
                                            @T[KeysText.ImportKeyButton]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (_selectingIndex >= 0)
                    {
                        <div class="border rounded p-3 mb-3">
                            <p>@Html(UiText.Of(KeysText.ImportingAddress, ("address", Model.ContainerKeys[_selectingIndex].Address)), ("address", "code"))</p>
                            <div class="mb-3">
                                <label for="add-select-label" class="form-label">@T[CommonText.FieldLabel]</label>
                                <input id="add-select-label" class="form-control" @bind="_selectLabel" @bind:event="oninput" disabled="@_busy" />
                            </div>
                            <div class="mb-3">
                                <label for="add-select-network" class="form-label">@T[CommonText.FieldNetwork]</label>
                                <NetworkSelect Id="add-select-network" @bind-Value="_selectNetwork" Disabled="_busy" />
                            </div>
                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="DoSelect">@T[KeysText.PreviewButton]</button>
                            <button type="button" class="btn btn-outline-secondary ms-2" disabled="@_busy" @onclick="() => _selectingIndex = -1">
                                @T[CommonText.Cancel]
                            </button>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="DoCloseContainer">
                        @T[KeysText.CloseBackupButton]
                    </button>
                }
                break;
        }

        @if (Model.Preview is { } preview)
        {
            <div class="alert alert-info mt-3">
                <p>@Html(UiText.Of(KeysText.StoredAs, ("address", preview.Address), ("algorithm", preview.Algorithm)), ("address", "code"))</p>
                <button type="button" class="btn btn-success" disabled="@_busy" @onclick="StoreAsync">@T[KeysText.AddToVaultButton]</button>
            </div>
        }
    </section>

    @if (_stored is { } storedAddress)
    {
        <div class="alert alert-success mt-3">@Html(UiText.Of(KeysText.AddedToVault, ("address", storedAddress)), ("address", "code"))</div>
    }

}

@code {
    [Parameter]
    public EventCallback OnDone { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private bool _disposed;

    private string _label = string.Empty;
    private string _network = string.Empty;
    private string _seed = string.Empty;

    private string _containerPassword = string.Empty;
    private int _selectingIndex = -1;
    private string _selectLabel = string.Empty;
    private string _selectNetwork = string.Empty;

    private string? _unexportedReference;
    private string? _stored;
    private bool _busy;

    protected override void OnInitialized()
    {
        Nav.Changed += OnNavChanged;
        Choices.Refresh();
    }

    /// <summary>
    /// Redraws when something outside this component moves the import tab. Through InvokeAsync and
    /// behind the _disposed check for the reason Shell.razor's OnTabChanged gives.
    /// </summary>
    private void OnNavChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    private void SwitchMode(ImportTab tab)
    {
        if (Nav.ImportTab == tab)
        {
            return;
        }

        Nav.ShowImportTab(tab);

        // A Preview left over from the tab just left belongs to input this screen is no longer
        // showing; clearing it here is what keeps the address in "Add to vault" always matching the
        // tab currently on screen. The container route's own open state (ContainerKeys) is untouched
        // -- switching away from it and back should not force reopening the file.
        Model.ClearPreview();
    }

    private void DoImport()
    {
        Model.Import(new AddKeyDraft(_label, _network, _seed, null));
        _seed = string.Empty;
    }

    private async Task PickFileAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            byte[]? bytes = await FilePicker.PickFileAsync(_lifetime.Token);
            if (bytes is null)
            {
                return;
            }

            string? password = string.IsNullOrEmpty(_containerPassword) ? null : _containerPassword;
            Model.OpenContainer(bytes, password);
            _containerPassword = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginSelect(int index, ContainerKeyOption key)
    {
        _selectingIndex = index;
        _selectLabel = key.Label ?? string.Empty;

        // The backup's own network is offered only when the list can show it; a Wallet backup carries
        // none, and a name outside the list is left for the person to choose rather than guessed at.
        _selectNetwork = Choices.Pick(key.Network) ?? string.Empty;
    }

    private void DoSelect()
    {
        if (Model.SelectContainerKey(_selectingIndex, _selectLabel, _selectNetwork))
        {
            _selectingIndex = -1;
        }
    }

    private void DoCloseContainer()
    {
        Model.CloseContainer();
        _selectingIndex = -1;
        _containerPassword = string.Empty;
    }

    private async Task StoreAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _stored = null;
        StateHasChanged();

        // Captured before the call: a successful StoreAsync clears Model.Preview as part of
        // marking nothing pending any more, so reading the address afterwards would always find it
        // gone.
        string? previewAddress = Model.Preview?.Address;
        try
        {
            string reference = await Model.StoreAsync(_lifetime.Token);
            if (reference == string.Empty)
            {
                return;
            }

            // The entry's own kind, through the model, not the tab this screen happens to be on:
            // a container this application wrote for a generated key, re-imported through the
            // "Open a backup file" tab, is a Generated entry that the accounts list flags and that the
            // import route used to walk past without ever offering the export step.
            if (Model.LastStoredNeedsExporting)
            {
                _unexportedReference = reference;
                return;
            }

            _stored = previewAddress;
            _label = string.Empty;
            _network = string.Empty;
            _selectLabel = string.Empty;
            _selectNetwork = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAsync()
    {
        _unexportedReference = null;
        await OnDone.InvokeAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Nav.Changed -= OnNavChanged;
        // Design's own rule for this screen (task-12 brief): a multi-key backup's decrypted seeds,
        // and whatever SelectContainerKey most recently prepared from them, must not simply wait on
        // the garbage collector once the add-key screen is dismissed -- whichever way it is dismissed,
        // since Dispose runs regardless of which button sent it away. CloseContainer also resets any
        // stray Preview or Problem left from the Import route (see its own remarks), so
        // this is a clean slate for the next time the screen opens, not just the container route.
        Model.CloseContainer();
        _lifetime.End();
    }
}
