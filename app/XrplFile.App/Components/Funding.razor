@implements IDisposable
@inject FundingModel Model
@inject IJSRuntime JS

@* Design 4.1 and 4.3: the address to send to, its QR, and what the account holds now.
   FundingModel computes no target amount (G10) and this screen adds none of its own -- a wallet
   scanning the code is free to send whatever the person decided. Model.AccountExists is what
   chooses between the balance and "not funded yet" below, and BalanceLine says neither until a node
   has actually answered (an imported key is usually an account that exists already); this markup
   never compares BalanceDrops to zero itself. The QR is drawn the same way ExportKey.razor draws one: QrMatrix.Build runs once,
   off Model.QrPayload, and OnAfterRenderAsync paints the canvas the one time that matters.

   FundingModel is a singleton, and SelectAsync deliberately assigns Address only once the lookup
   has actually resolved -- its own remarks explain why: a failed or slow lookup must not blank
   whatever the previous selection left on screen. That means Model.Address can be a PREVIOUS row's
   address even after this component's own SelectAsync call has returned, if that call itself was
   the one that failed (a locked vault between two visits, an entry that vanished) -- waiting for
   the call to return, which an earlier version of this file did, closes only the render race, not
   this one: a failed select still leaves Address, and a live Copy button over it, on screen with
   nothing saying anything went wrong. Ready below waits for the OUTCOME instead, by comparing
   Model.CurrentReference -- which FundingModel sets only once a select actually resolves for a
   given reference -- to this component's own Reference. Model.Message is still shown unconditionally
   above, failed select included, so the explanation a failed select set is not hidden behind Ready
   being false. *@

<h1 class="xf-title">Fund this account</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-warning">@Model.Message</div>
}

@if (!Ready)
{
    <p>Loading&hellip;</p>
}
else
{
    <p>@Model.InstructionText</p>

    @if (Model.Address is { } address)
    {
        <section class="xf-card">
            <p><code class="user-select-all xf-mono">@address</code></p>

            <div style="-webkit-touch-callout: none; display: inline-block;">
                <canvas @ref="_qrCanvas"></canvas>
            </div>

            <div class="mt-2">
                <button type="button" class="btn btn-outline-secondary" disabled="@_copying" @onclick="CopyAsync">
                    Copy address
                </button>
            </div>
        </section>

        <p class="mt-3">
            <span class="@(Model.AccountExists ? "" : "text-muted")">@Model.BalanceLine</span>
        </p>

        @if (!Model.AccountExists)
        {
            <p class="xf-muted small">
                This screen checks the ledger again every @((int)FundingModel.PollInterval.TotalSeconds) seconds.
            </p>
            <button type="button" class="btn btn-outline-secondary" disabled="@(_checking || Model.IsRefreshing)" @onclick="CheckNowAsync">
                Check now
            </button>
        }
    }
}

<div class="mt-3">
    <button type="button" class="btn btn-outline-secondary" @onclick="BackAsync"><BackIcon /> Back to accounts</button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Reference { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private ElementReference _qrCanvas;
    private bool[][]? _pendingMatrix;
    private bool _copying;
    private bool _checking;
    private bool _disposed;

    /// <summary>
    /// Whether Model's data is actually resolved for THIS component's own Reference, read live off
    /// the model rather than cached in a field set once at the end of OnInitializedAsync -- a cached
    /// flag would say "ready" forever after a successful select even though nothing re-checks it,
    /// and would need its own careful reset on every failure path. Comparing live costs nothing and
    /// cannot drift out of step with the model.
    /// </summary>
    private bool Ready => string.Equals(Model.CurrentReference, Reference, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await Model.SelectAsync(Reference, _lifetime.Token);

        if (!Ready)
        {
            return;
        }

        await Model.RefreshAsync(_lifetime.Token);

        _pendingMatrix = Model.QrPayload is { } payload ? QrMatrix.Build(payload) : null;

        // Not awaited: the loop runs for as long as the account is missing, and rendering must not wait
        // on it. It ends on its own when the account exists or this component is disposed.
        _ = PollAsync(_lifetime.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Model.PollAsync(NotifyChangedAsync, cancellationToken);

            // Whoever else updated the model while the loop waited -- the Check now button -- has
            // drawn its own answer; this covers the loop ending on an account found some other way.
            if (!cancellationToken.IsCancellationRequested)
            {
                await NotifyChangedAsync();
            }
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private Task NotifyChangedAsync() =>
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });

    private async Task CheckNowAsync()
    {
        if (_checking)
        {
            return;
        }

        _checking = true;
        StateHasChanged();
        try
        {
            await Model.RefreshAsync(_lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _checking = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingMatrix is { } matrix)
        {
            _pendingMatrix = null;
            await JS.InvokeVoidAsync("drawQrMatrix", _lifetime.Token, _qrCanvas, matrix);
        }
    }

    private async Task CopyAsync()
    {
        if (_copying)
        {
            return;
        }

        _copying = true;
        StateHasChanged();
        try
        {
            await Model.CopyAddressAsync(_lifetime.Token);
        }
        finally
        {
            _copying = false;
        }
    }

    private Task BackAsync() => OnBack.InvokeAsync();

    public void Dispose()
    {
        _disposed = true;
        _lifetime.End();
    }
}
