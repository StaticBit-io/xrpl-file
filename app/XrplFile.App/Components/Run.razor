@implements IDisposable
@inject RunModel Model
@inject IClipboardService Clipboard

@* Design 4.3: the run in progress, and its outcome. CanCancel, IsFinished, WasCancelled, Link,
   Failure, HistoryNote, StageText and Percent are all RunModel's own, read here as one RunView taken
   once, at the top of this render, via RunModel.Capture -- not as eight separate RunModel property
   reads. RunModel.Capture's own remarks explain why: PublicationRun runs on a background task this
   screen never awaits, so a render that read those eight facts separately could see the run finish
   partway through them, e.g. an enabled Cancel button drawn directly above a "Published" alert. This
   component only chooses which of the captured facts to draw right now, never what any of them says.
   RunModel's own remarks are explicit that a HistoryNote can sit beside a successful Link -- not a
   failure -- which is why it is shown in its own alert rather than folded into the failure branch
   below. WasCancelled is its own branch for the same reason: PublicationRun leaves Failure null on a
   cancellation (cancelling was something the person did, not a fault), which used to leave this
   screen with neither Link nor Failure to show -- a frozen progress bar and a Dismiss button with no
   outcome stated at all. TicketNote and StateNote are RunModel's too, decided from the same view:
   whether there is anything to say about the tidy-up or the state file, what it says, and whether
   tickets may still hold a reserve (TicketsLocked, which picks the alert's colour).

   The poll matches Shell.razor's and Publish.razor's own shape and interval: PublicationRun runs on
   a background task this screen never awaits, so nothing repaints on progress without a render
   forced from outside it. Copying a finished link is plumbing, not a decision -- there is no branch
   here over what to copy or when the button is enabled beyond IsFinished already having decided that
   a link exists (CopyLinkAsync reads Model.Link fresh, at the moment the button is actually pressed,
   which is a different instant than the render that drew it and is exactly when a fresh read is
   correct). Dismiss additionally fires OnDismissed: Publish.razor's own poll would otherwise notice
   Model.Dismiss() having reset the run's state up to a second late, during which this component
   would go on rendering itself -- StageText back to "Starting", Percent back to zero -- against an
   already-Idle run. *@

@{
    RunView view = Model.Capture();
}

<div class="xf-page">
    <h1 class="xf-title">Publishing</h1>

    <section class="xf-card">
        <p>@view.StageText</p>
        <div class="progress" role="progressbar" aria-valuenow="@view.Percent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @(view.Percent)%">@view.Percent%</div>
        </div>
    </section>

    @if (view.IsFinished)
    {
        @if (view.Link is { } link)
        {
            <div class="alert alert-success mt-3">
                <p class="mb-2">Published.</p>
                <code class="d-block p-2 bg-body-tertiary text-break user-select-all xf-mono">@link</code>
                <button type="button" class="btn btn-outline-secondary mt-2" @onclick="CopyLinkAsync">Copy link</button>
            </div>
        }
        else if (view.Failure is { } failure)
        {
            <div class="alert alert-danger mt-3">@failure</div>
        }
        else if (view.WasCancelled)
        {
            <div class="alert alert-secondary mt-3">Cancelled. Nothing further was submitted.</div>
        }

        @if (view.HistoryNote is { } note)
        {
            <div class="alert alert-info mt-3">@note</div>
        }

        @if (view.TicketNote is { } ticketNote)
        {
            <div class="alert @(view.TicketsLocked ? "alert-warning" : "alert-info") mt-3">@ticketNote</div>
        }

        @if (view.StateNote is { } stateNote)
        {
            <div class="alert alert-info mt-3">@stateNote</div>
        }
    }

    <div class="xf-actionbar">
        @if (!view.IsFinished)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@(!view.CanCancel)" @onclick="Cancel">
                Cancel
            </button>
        }
        @if (view.IsFinished)
        {
            <button type="button" class="btn btn-primary" @onclick="Dismiss">Dismiss</button>
        }
    </div>
</div>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly CancellationTokenSource _cts = new();
    private Timer? _pollTimer;
    private bool _disposed;

    /// <summary>
    /// Fired once <see cref="RunModel.Dismiss"/> has actually been called, so a parent that only
    /// shows this component while a run is active (Publish.razor, through RunModel.IsActive) can
    /// re-evaluate that immediately rather than through its own, separate poll.
    /// </summary>
    [Parameter]
    public EventCallback OnDismissed { get; set; }

    protected override void OnInitialized() =>
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);

    private void OnPollTick(object? state)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            StateHasChanged();
        });
    }

    private void Cancel() => Model.Cancel();

    private async Task Dismiss()
    {
        Model.Dismiss();
        await OnDismissed.InvokeAsync();
    }

    private Task CopyLinkAsync() =>
        Model.Link is { } link ? Clipboard.CopyAsync(link, _cts.Token) : Task.CompletedTask;

    public void Dispose()
    {
        _disposed = true;
        _pollTimer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
}
