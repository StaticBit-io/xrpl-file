@implements IDisposable
@inject NewAccountModel Model
@inject NetworkChoices Choices

@* Design 4.1: generating a throwaway key, not an account -- NewAccountModel's own remarks are
   explicit that nothing is on the ledger until somebody funds the address this produces, and this
   screen says so in fixed copy rather than leaving it implied. CanCreate is the model's own
   decision (a label given, a network an xrpl-file link can name); this markup only reads it to
   decide whether the button is live. *@

<BackLink To="AppTab.Accounts" OnClick="DoneAsync" Disabled="_busy" />
<h1 class="xf-title">@T[AccountsText.NewTitle]</h1>

<p>
    @T[AccountsText.NewIntro]
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-warning">@T[Model.Message]</div>
}

<section class="xf-card">
    <div class="mb-3" data-tour="@TutorialRegions.NewLabel">
        <label class="form-label">@T[CommonText.FieldLabel]</label>
        <input class="form-control" @bind="Model.Label" @bind:event="oninput" disabled="@_busy" />
    </div>

    <div class="mb-3" data-tour="@TutorialRegions.NewNetwork">
        <label for="new-account-network" class="form-label">@T[CommonText.FieldNetwork]</label>
        <NetworkSelect Id="new-account-network" @bind-Value="Model.Network" Disabled="_busy" />
    </div>

    <button type="button" class="btn btn-primary" disabled="@(!Model.CanCreate || _busy)" data-tour="@TutorialRegions.NewGenerate" @onclick="CreateAsync">
        @T[AccountsText.NewGenerateButton]
    </button>
</section>

@code {
    [Parameter]
    public EventCallback OnDone { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private bool _busy;

    protected override void OnInitialized() => Choices.Refresh();

    private async Task CreateAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            string? reference = await Model.CreateAsync(_lifetime.Token);
            if (reference is not null)
            {
                // Cleared only on success, matching AddKey.razor's own reasoning: a refused label or
                // network has to stay on screen so it can be corrected, not retyped from scratch.
                Model.Label = string.Empty;
                Model.Network = "mainnet";
                await OnDone.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task DoneAsync() => OnDone.InvokeAsync();

    public void Dispose()
    {
        _lifetime.End();
    }
}
