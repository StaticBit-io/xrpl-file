@implements IDisposable
@inject DeviceUnlockModel Model
@inject VaultLocationModel LocationModel
@inject IFilePickerService FilePicker
@inject NodeSettingsModel NodeSettings
@inject Localizer Localizer

@* Design 6, "Settings": the vault's own path, a button that reveals it in the file manager, opening
   a different vault, and the device-unlock switch. DeviceUnlockModel.IsEnabledAsync is re-read after
   every toggle rather than cached locally -- see the model's own remarks on why a cached flag here
   would be exactly the defect VaultListModel's own history already found once.
   "Opening a different vault" is VaultLocationModel: it records the chosen path through
   IVaultLocationStore and takes effect on the next start, because IKeyVault is wired as a singleton
   over one path for the whole process (MauiProgram.RegisterVault) and nothing here can repoint it
   without restarting -- see that model's own remarks for why a restart, rather than a control that
   pretends to repoint a running vault, is the honest shape for this. *@

@* Both branches share this wrapper -- ChangePassword used to render outside any width- or
   padding-constrained container when reached from here, the one screen in this file (unlike
   Accounts, which wraps its own AddKey / ExportKey / RevealSeed sub-views the same way) that had
   its own top-level container instead of relying on a parent's. Wrapping both branches in the
   same div is what Accounts already does for its own children; this brings Settings in line with
   it rather than leaving ChangePassword to full-bleed edge to edge. *@
<div class="xf-page">
    @if (_showChangePassword)
    {
        <ChangePassword OnBack="() => _showChangePassword = false" />
    }
    else
    {
        <h1 class="xf-title">@T[SettingsText.Title]</h1>

        <section class="xf-card">
            <h2 class="xf-section-title">@T[SettingsText.LanguageTitle]</h2>
            <label class="form-label" for="xf-language">@T[SettingsText.LanguageLabel]</label>
            @* Names are in their own language and never translated, so anyone finds theirs whatever is on screen. *@
            <select id="xf-language" class="form-select xf-language-select" value="@Localizer.Language.Code" @onchange="ChooseLanguage">
                @foreach (UiLanguage language in Localizer.Choices)
                {
                    <option value="@language.Code" lang="@language.HtmlTag">@language.NativeName</option>
                }
            </select>
            @if (_languageNotRemembered)
            {
                <div class="alert alert-warning mt-2 mb-0" role="status">@T[SettingsText.LanguageNotRemembered]</div>
            }
        </section>

        <section class="xf-card">
            <h2 class="xf-section-title">@T[SettingsText.VaultLocationTitle]</h2>
            <p>@T[SettingsText.VaultLocationIntro]</p>
            <code class="d-block p-2 bg-body-tertiary text-break xf-mono">@LocationModel.CurrentPath</code>
            <button type="button" class="btn btn-outline-secondary mt-2" @onclick="RevealInFileManager">
                @T[SettingsText.ShowInFileManager]
            </button>
        </section>

        <section class="xf-card">
            <h2 class="xf-section-title">@T[SettingsText.DifferentVaultTitle]</h2>
            <p>
                @T[SettingsText.DifferentVaultIntro]
            </p>
            <p>
                @T[SettingsText.DifferentVaultDeviceUnlock]
            </p>
            <button type="button" class="btn btn-outline-secondary" disabled="@_choosingVault"
                    @onclick="ChooseVaultAsync">
                @T[SettingsText.ChooseVaultFile]
            </button>
            @if (_chooseVaultOutcome is { } chooseOutcome)
            {
                <div class="alert mt-2 @(chooseOutcome.Succeeded ? "alert-info" : "alert-danger")">
                    @T[chooseOutcome.Message]
                </div>
            }
        </section>

        <section class="xf-card">
            <h2 class="xf-section-title">@T[SettingsText.RememberTitle]</h2>
            <p>
                @T[SettingsText.RememberIntro]
            </p>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="device-unlock-switch"
                       checked="@_deviceUnlockEnabled" disabled="@_busy" @onchange="ToggleDeviceUnlockAsync" />
                <label class="form-check-label" for="device-unlock-switch">@T[SettingsText.DeviceUnlockSwitchLabel]</label>
            </div>
            @if (Model.Problem is { } problem)
            {
                <div class="alert alert-warning mt-2">@T[problem]</div>
            }
        </section>

        <section class="xf-card">
            <h2 class="xf-section-title">@T[SettingsText.NodeUrlsTitle]</h2>
            <p>
                @Html(UiText.Of(SettingsText.NodeUrlsIntro, ("ws", "ws://"), ("wss", "wss://")), ("ws", "code"), ("wss", "code"))
            </p>
            @foreach (NodeSettingRow row in NodeSettings.Rows)
            {
                <div class="mb-2">
                    @if (KnownServers.IsKnown(row.Network))
                    {
                        string selection = ServerSelection(row.Network);
                        <label for="node-server-@row.Network" class="form-label">@row.Network</label>
                        <select id="node-server-@row.Network" class="form-select" value="@selection"
                                @onchange="e => SetServer(row.Network, (string)e.Value!)">
                            @foreach (ServerOption option in KnownServers.Options(row.Network))
                            {
                                <option value="@option.Value" selected="@(option.Value == selection)">@T[option.Label]</option>
                            }
                        </select>
                        @if (selection == KnownServers.CustomValue)
                        {
                            <input id="node-custom-@row.Network" class="form-control mt-2" placeholder="wss://…"
                                   aria-label="@T[UiText.Of(SettingsText.CustomUrlFor, ("network", row.Network))]"
                                   value="@NodeEdit(row.Network)" @oninput="e => SetNodeEdit(row.Network, (string)e.Value!)" />
                        }
                    }
                    else
                    {
                        <label for="node-url-@row.Network" class="form-label">@row.Network</label>
                        <input id="node-url-@row.Network" class="form-control" placeholder="wss://…"
                               value="@NodeEdit(row.Network)" @oninput="e => SetNodeEdit(row.Network, (string)e.Value!)" />
                    }
                </div>
            }
            <button type="button" class="btn btn-outline-primary mt-2" @onclick="SaveNodes">
                @T[SettingsText.SaveNodeUrls]
            </button>

            <div class="mt-3">
                <label class="form-label">@T[SettingsText.AddNetworkLabel]</label>
                <p class="text-body-secondary mb-2">
                    @Html(UiText.Of(SettingsText.AddNetworkHint, ("example", "1")), ("example", "code"))
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control" style="max-width: 12rem;" placeholder="@T[SettingsText.NewNetworkNamePlaceholder]"
                           value="@_newNetworkName" @oninput="e => _newNetworkName = (string)e.Value!" />
                    <input class="form-control" style="max-width: 20rem;" placeholder="wss://…"
                           value="@_newNetworkUrl" @oninput="e => _newNetworkUrl = (string)e.Value!" />
                    <button type="button" class="btn btn-outline-primary" @onclick="AddNetwork">@T[SettingsText.AddNetworkButton]</button>
                </div>
            </div>

            @if (NodeSettings.Message is { } nodeProblem)
            {
                <div class="alert alert-warning mt-2">@T[nodeProblem]</div>
            }
            else if (_nodesSaved)
            {
                <div class="alert alert-success mt-2">@T[SettingsText.NodesSaved]</div>
            }
        </section>

        <button type="button" class="btn btn-outline-primary" @onclick="() => _showChangePassword = true">
            @T[SettingsText.ChangePasswordButton]
        </button>
    }
</div>

@code {
    private readonly ScreenLifetime _lifetime = new();
    private readonly Dictionary<string, string> _nodeEdits = new(StringComparer.Ordinal);
    private readonly HashSet<string> _customRows = new(StringComparer.Ordinal);
    private bool _showChangePassword;
    private bool _languageNotRemembered;
    private bool _deviceUnlockEnabled;
    private bool _busy;
    private bool _choosingVault;
    private bool _nodesSaved;
    private string _newNetworkName = string.Empty;
    private string _newNetworkUrl = string.Empty;
    private VaultLocationModel.Outcome? _chooseVaultOutcome;

    protected override async Task OnInitializedAsync()
    {
        _deviceUnlockEnabled = await Model.IsEnabledAsync(_lifetime.Token);

        NodeSettings.Refresh();
        RestartNodeEdits();
    }

    // The boxes hold their own typed-but-not-yet-saved text; NodeSettingsModel.Rows only ever carries
    // what was last saved. Reset every time Rows changes underneath -- after the initial Refresh
    // above and after a successful SaveNodes below -- so the boxes never show one save's edits
    // sitting on top of a different save's own result.
    private void RestartNodeEdits()
    {
        _nodeEdits.Clear();
        _customRows.Clear();
        foreach (NodeSettingRow row in NodeSettings.Rows)
        {
            _nodeEdits[row.Network] = row.Url;
            if (KnownServers.IsKnown(row.Network) && KnownServers.Selection(row.Network, row.Url) == KnownServers.CustomValue)
            {
                _customRows.Add(row.Network);
            }
        }
    }

    private void ChooseLanguage(ChangeEventArgs args)
    {
        if (UiLanguage.FromCode(args.Value as string) is { } language)
        {
            _languageNotRemembered = !Localizer.Choose(language);
        }
    }

    private string NodeEdit(string network) => _nodeEdits.TryGetValue(network, out string? value) ? value : string.Empty;

    // A row stays on "Custom URL" while its box is open even when the box is empty or holds a listed
    // server's address, so choosing it does not snap straight back to the entry it was chosen from.
    private string ServerSelection(string network) =>
        _customRows.Contains(network) ? KnownServers.CustomValue : KnownServers.Selection(network, NodeEdit(network));

    private void SetServer(string network, string value)
    {
        if (value == KnownServers.CustomValue)
        {
            if (KnownServers.Selection(network, NodeEdit(network)) != KnownServers.CustomValue)
            {
                _nodeEdits[network] = string.Empty;
            }

            _customRows.Add(network);
        }
        else
        {
            _customRows.Remove(network);
            _nodeEdits[network] = value;
        }

        _nodesSaved = false;
    }

    private void SetNodeEdit(string network, string value)
    {
        _nodeEdits[network] = value;
        _nodesSaved = false;
    }

    private void SaveNodes()
    {
        _nodesSaved = NodeSettings.Save(_nodeEdits);
        if (_nodesSaved)
        {
            RestartNodeEdits();
        }
    }

    private void AddNetwork()
    {
        _nodesSaved = NodeSettings.AddNetwork(_newNetworkName, _newNetworkUrl);
        if (_nodesSaved)
        {
            _newNetworkName = string.Empty;
            _newNetworkUrl = string.Empty;
            RestartNodeEdits();
        }
    }

    private void RevealInFileManager()
    {
        // A plain OS action, not a vault decision: this project's Windows target only, the same way
        // MauiFilePickerService already reaches for a Windows-specific API directly rather than
        // through a seam in App.Core.
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"/select,\"{LocationModel.CurrentPath}\"",
                UseShellExecute = true,
            });
        }
        catch (System.ComponentModel.Win32Exception)
        {
            // Nothing this screen can do about a shell that refused to launch; the path is already
            // on screen above for the user to navigate to by hand.
        }
    }

    private async Task ChooseVaultAsync()
    {
        if (_choosingVault)
        {
            return;
        }

        _choosingVault = true;
        _chooseVaultOutcome = null;
        StateHasChanged();

        try
        {
            string? path = await FilePicker.PickExistingFilePathAsync(_lifetime.Token);
            if (path is null)
            {
                return;
            }

            // Every word, success or failure, is the model's. A read-only or full profile
            // directory used to throw straight out of the store and past this handler into the
            // framework's own "An unhandled error has occurred."
            _chooseVaultOutcome = LocationModel.ChoosePath(path);
        }
        finally
        {
            _choosingVault = false;
        }
    }

    private async Task ToggleDeviceUnlockAsync(ChangeEventArgs args)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        bool turnOn = args.Value is true;
        try
        {
            // Both outcomes carry their own words now: a store that refused and a vault that threw
            // both reach Model.Problem, so this handler no longer composes a sentence for one of
            // them while routing the other through VaultErrorMessages two lines below.
            if (turnOn)
            {
                await Model.EnableAsync(_lifetime.Token);
            }
            else
            {
                await Model.DisableAsync(_lifetime.Token);
            }
        }
        finally
        {
            _deviceUnlockEnabled = await Model.IsEnabledAsync(_lifetime.Token);
            _busy = false;
        }
    }

    public void Dispose()
    {
        _lifetime.End();
    }
}
