@implements IDisposable
@inject DeviceUnlockModel Model
@inject VaultLocationModel LocationModel
@inject IFilePickerService FilePicker

@* Design 6, "Settings": the vault's own path, a button that reveals it in the file manager, opening
   a different vault, and the device-unlock switch. DeviceUnlockModel.IsEnabledAsync is re-read after
   every toggle rather than cached locally -- see the model's own remarks on why a cached flag here
   would be exactly the defect VaultListModel's own history already found once.
   "Opening a different vault" is VaultLocationModel: it records the chosen path through
   IVaultLocationStore and takes effect on the next start, because IKeyVault is wired as a singleton
   over one path for the whole process (MauiProgram.RegisterVault) and nothing here can repoint it
   without restarting -- see that model's own remarks for why a restart, rather than a control that
   pretends to repoint a running vault, is the honest shape for this. *@

@* Both branches share this wrapper -- ChangePassword used to render outside any width- or
   padding-constrained container when reached from here, the one screen in this file (unlike
   KeyList, which wraps its own AddKey / ExportKey / RevealSeed sub-views the same way) that had
   its own top-level container instead of relying on a parent's. Wrapping both branches in the
   same div is what KeyList already does for its own children; this brings Settings in line with
   it rather than leaving ChangePassword to full-bleed edge to edge. *@
<div class="container py-3" style="max-width: 560px;">
    @if (_showChangePassword)
    {
        <ChangePassword OnBack="() => _showChangePassword = false" />
    }
    else
    {
        <h1 class="h3">Settings</h1>

        <section class="mb-4">
            <h2 class="h5">Vault location</h2>
            <p>The vault file lives at:</p>
            <code class="d-block p-2 bg-body-tertiary text-break">@LocationModel.CurrentPath</code>
            <button type="button" class="btn btn-outline-secondary mt-2" @onclick="RevealInFileManager">
                Show in file manager
            </button>
        </section>

        <section class="mb-4">
            <h2 class="h5">A different vault</h2>
            <p>
                Point the application at a vault file kept somewhere else — a copy on a memory
                stick, a synced folder, a file carried over from another machine. Because the
                vault file is portable, the copy opens exactly like the original.
            </p>
            <p>
                A vault opened from a different path has no device unlock of its own: "remember on
                this device" is tied to the exact path a vault was opened from, so it always asks
                for the master password the first time, even if this switch is on below for the
                vault at the path above.
            </p>
            <button type="button" class="btn btn-outline-secondary" disabled="@_choosingVault"
                    @onclick="ChooseVaultAsync">
                Choose a vault file&hellip;
            </button>
            @if (_chooseVaultOutcome is { } chooseOutcome)
            {
                <div class="alert mt-2 @(chooseOutcome.Succeeded ? "alert-info" : "alert-danger")">
                    @chooseOutcome.Message
                </div>
            }
        </section>

        <section class="mb-4">
            <h2 class="h5">Remember on this device</h2>
            <p>
                Tied to the path above: renaming or moving the vault file asks for the master
                password once, even with this switched on.
            </p>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="device-unlock-switch"
                       checked="@_deviceUnlockEnabled" disabled="@_busy" @onchange="ToggleDeviceUnlockAsync" />
                <label class="form-check-label" for="device-unlock-switch">Unlock with this device</label>
            </div>
            @if (Model.Problem is { } problem)
            {
                <div class="alert alert-warning mt-2">@problem</div>
            }
        </section>

        <button type="button" class="btn btn-outline-primary" @onclick="() => _showChangePassword = true">
            Change master password
        </button>
    }
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _showChangePassword;
    private bool _deviceUnlockEnabled;
    private bool _busy;
    private bool _choosingVault;
    private VaultLocationModel.Outcome? _chooseVaultOutcome;

    protected override async Task OnInitializedAsync()
    {
        _deviceUnlockEnabled = await Model.IsEnabledAsync(_cts.Token);
    }

    private void RevealInFileManager()
    {
        // A plain OS action, not a vault decision: this project's Windows target only, the same way
        // MauiFilePickerService already reaches for a Windows-specific API directly rather than
        // through a seam in App.Core.
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"/select,\"{LocationModel.CurrentPath}\"",
                UseShellExecute = true,
            });
        }
        catch (System.ComponentModel.Win32Exception)
        {
            // Nothing this screen can do about a shell that refused to launch; the path is already
            // on screen above for the user to navigate to by hand.
        }
    }

    private async Task ChooseVaultAsync()
    {
        if (_choosingVault)
        {
            return;
        }

        _choosingVault = true;
        _chooseVaultOutcome = null;
        StateHasChanged();

        try
        {
            string? path = await FilePicker.PickExistingFilePathAsync(_cts.Token);
            if (path is null)
            {
                return;
            }

            // Every word, success or failure, is the model's. A read-only or full profile
            // directory used to throw straight out of the store and past this handler into the
            // framework's own "An unhandled error has occurred."
            _chooseVaultOutcome = LocationModel.ChoosePath(path);
        }
        finally
        {
            _choosingVault = false;
        }
    }

    private async Task ToggleDeviceUnlockAsync(ChangeEventArgs args)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        bool turnOn = args.Value is true;
        try
        {
            // Both outcomes carry their own words now: a store that refused and a vault that threw
            // both reach Model.Problem, so this handler no longer composes a sentence for one of
            // them while routing the other through VaultErrorMessages two lines below.
            if (turnOn)
            {
                await Model.EnableAsync(_cts.Token);
            }
            else
            {
                await Model.DisableAsync(_cts.Token);
            }
        }
        finally
        {
            _deviceUnlockEnabled = await Model.IsEnabledAsync(_cts.Token);
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
