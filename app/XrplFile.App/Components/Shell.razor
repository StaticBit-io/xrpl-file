@implements IDisposable
@using XrplFile.App
@inject UnlockModel Model
@inject ShellModel Tabs
@inject IJSRuntime JS

@* One window, no router (design section 6). What renders is entirely the model's own Stage --
   this component switches on it but never sets it, and never composes a word of its own.

   The timer below is why that Stage is ever right: the vault can be shut by something this screen
   never hears about -- VaultAutoLock's idle window, or App.xaml.cs locking on the window closing --
   and IKeyVault raises no notification, so a shell that only recomputed on user events went on
   drawing the key list and a Lock button over a vault that was already locked. RevealSeed.razor
   polls once a second for exactly the same reason and states the same limit in its own comment;
   this is the same mechanism at the same interval, so the two screens can never disagree about
   whether the vault is open. UnlockModel.NoticeLock is what makes it cheap enough to do every
   second -- one property read, no file touched -- and the model, not this markup, is what decides
   that a shut vault behind an unlocked screen means the screen is stale. *@

@if (_failure is not null)
{
    <div class="xf-vault">
        <section class="xf-card">
            <div class="alert alert-danger mb-0" role="alert">
                <p>This application could not start.</p>
                <p class="mb-0"><small>@_failure</small></p>
            </div>
        </section>
    </div>
}
else if (_ready)
{
    @switch (Model.Stage)
    {
        case UnlockStage.NoVault:
            <CreateVault OnChanged="StateHasChanged" />
            break;

        case UnlockStage.VaultUnreachable:
            <VaultUnreachable OnChanged="StateHasChanged" />
            break;

        case UnlockStage.Locked:
            <Unlock OnChanged="StateHasChanged" />
            break;

        case UnlockStage.Unlocked:
            <div class="xf-shell">
                <header class="xf-topbar">
                    <span class="xf-rail-mark" aria-hidden="true">@Mark</span>
                    <button type="button" class="xf-icon-button" aria-label="Lock the vault" @onclick="LockAsync">@LockIcon</button>
                </header>

                <nav class="xf-rail" aria-label="Main">
                    <span class="xf-rail-mark" aria-hidden="true">@Mark</span>
                    @foreach (AppTab tab in RailTabs)
                    {
                        <button type="button" class="xf-rail-item" aria-current="@(Tabs.Tab == tab ? "page" : null)"
                                @onclick="() => ShowTab(tab)">
                            @Icon(tab)<span>@tab</span>
                        </button>
                    }
                    <span class="xf-rail-spacer"></span>
                    <button type="button" class="xf-rail-item" aria-label="Lock the vault" @onclick="LockAsync">
                        @LockIcon<span aria-hidden="true">Lock</span>
                    </button>
                </nav>

                <main id="xf-content" class="xf-content" tabindex="-1" @ref="_content">
                    <ScreenErrorBoundary @ref="_boundary">
                        <ChildContent>
                            @if (Tabs.Tab == AppTab.Keys)
                            {
                                <KeyList />
                            }
                            else if (Tabs.Tab == AppTab.Publish)
                            {
                                <Publish />
                            }
                            else if (Tabs.Tab == AppTab.History)
                            {
                                <History />
                            }
                            else if (Tabs.Tab == AppTab.Settings)
                            {
                                <Settings />
                            }
                            else if (Tabs.Tab == AppTab.Accounts)
                            {
                                <Accounts />
                            }
                            else if (Tabs.Tab == AppTab.Read)
                            {
                                <Read />
                            }
                        </ChildContent>
                        <ErrorContent>
                            <div class="xf-page">
                                <div class="alert alert-danger" role="alert">
                                    This screen stopped because of an error. Choose a tab to carry on.
                                </div>
                            </div>
                        </ErrorContent>
                    </ScreenErrorBoundary>
                </main>

                <nav class="xf-tabbar" aria-label="Main">
                    @foreach (AppTab tab in TabbarTabs)
                    {
                        <button type="button" class="xf-tab" aria-current="@(Tabs.Tab == tab ? "page" : null)"
                                @onclick="() => ShowTab(tab)">
                            @Icon(tab)<span>@tab</span>
                        </button>
                    }
                    <button type="button" class="xf-tab" @ref="_moreButton"
                            aria-expanded="@(Tabs.MoreOpen ? "true" : "false")" aria-controls="xf-more"
                            aria-current="@(Tabs.IsMoreCurrent ? "page" : null)" @onclick="ToggleMore">
                        @MoreIcon<span>More</span>
                    </button>

                    @if (Tabs.MoreOpen)
                    {
                        <div class="xf-more-backdrop" @onclick="CloseMoreAndReturnFocus"></div>
                        <div id="xf-more" class="xf-more">
                            <button type="button" class="xf-more-item" @ref="_firstMoreItem"
                                    aria-current="@(Tabs.Tab == AppTab.Accounts ? "page" : null)"
                                    @onclick="() => ChooseFromMore(AppTab.Accounts)">Accounts</button>
                            <button type="button" class="xf-more-item"
                                    aria-current="@(Tabs.Tab == AppTab.Settings ? "page" : null)"
                                    @onclick="() => ChooseFromMore(AppTab.Settings)">Settings</button>
                        </div>
                    }
                </nav>
            </div>
            break;
    }
}
else
{
    <div class="xf-vault">
        <section class="xf-card">
            <p class="xf-muted mb-0">Loading&hellip;</p>
        </section>
    </div>
}

@code {
    /// <summary>
    /// How often the shell asks whether the vault has been shut behind it. One second, matching
    /// RevealSeed.razor, so the two screens notice a lock at the same moment rather than one of
    /// them lagging the other.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly ScreenLifetime _lifetime = new();
    private Timer? _lockPollTimer;
    private bool _disposed;
    private bool _ready;

    /// <summary>
    /// Why the shell could not start, or <see langword="null"/>. Without this the gate below has
    /// no false branch worth drawing: a refresh that throws leaves _ready false for good, and the
    /// window then shows an empty page for the rest of its life with nothing said anywhere.
    /// </summary>
    private string? _failure;

    private static readonly AppTab[] RailTabs = [AppTab.Publish, AppTab.Read, AppTab.History, AppTab.Keys, AppTab.Accounts, AppTab.Settings];
    private static readonly AppTab[] TabbarTabs = [AppTab.Publish, AppTab.Read, AppTab.History, AppTab.Keys];

    private ElementReference _moreButton;
    private ElementReference _firstMoreItem;
    private ElementReference _content;
    private ScreenErrorBoundary? _boundary;
    private bool _focusFirstMoreItem;
    private bool _focusMoreButton;
    private bool _focusContent;
    private bool _watchingWidth;
    private DotNetObjectReference<Shell>? _self;

    private static readonly RenderFragment Mark =
        @<svg viewBox="0 0 19 19" width="22" height="22" stroke-width="1"><rect x="0.5" y="0.5" width="5" height="5" rx="0.5" fill="#BDC6CA" stroke="#BDC6CA"/><rect x="7" y="0.5" width="5" height="5" rx="0.5" fill="#BDC6CA" stroke="#BDC6CA"/><rect x="13.5" y="0.5" width="5" height="5" rx="0.5" fill="none" stroke="#89949A"/><rect x="0.5" y="7" width="5" height="5" rx="0.5" fill="none" stroke="#89949A"/><rect x="7" y="7" width="5" height="5" rx="0.5" fill="#BDC6CA" stroke="#BDC6CA"/><rect x="13.5" y="7" width="5" height="5" rx="0.5" fill="#BDC6CA" stroke="#BDC6CA"/><rect x="0.5" y="13.5" width="5" height="5" rx="0.5" fill="none" stroke="#89949A"/><rect x="7" y="13.5" width="5" height="5" rx="0.5" fill="none" stroke="#89949A"/><rect x="13.5" y="13.5" width="5" height="5" rx="0.5" fill="#BCF053" stroke="#BCF053"/></svg>;

    private static readonly RenderFragment LockIcon =
        @<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>;

    private static readonly RenderFragment MoreIcon =
        @<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>;

    private static RenderFragment Icon(AppTab tab) => tab switch
    {
        AppTab.Publish => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 20h16"/></svg>,
        AppTab.Read => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/></svg>,
        AppTab.History => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>,
        AppTab.Keys => @<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9"/><path d="M17 6l3 3"/></svg>,
        AppTab.Accounts => @<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M16 15h2"/></svg>,
        _ => @<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_watchingWidth && _ready && Model.Stage == UnlockStage.Unlocked)
        {
            _watchingWidth = true;
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("xfShell.watchWidth", _self);
        }

        if (_focusFirstMoreItem)
        {
            _focusFirstMoreItem = false;
            await _firstMoreItem.FocusAsync();
        }

        if (_focusMoreButton)
        {
            _focusMoreButton = false;
            await _moreButton.FocusAsync();
        }

        if (_focusContent)
        {
            _focusContent = false;
            await _content.FocusAsync();
        }
    }

    /// <summary>
    /// Choosing Accounts or Settings removes the panel and the button that had focus with it; focus
    /// goes to the screen that was just opened rather than falling to the page body.
    /// </summary>
    private void ChooseFromMore(AppTab tab)
    {
        ShowTab(tab);
        _focusContent = true;
    }

    /// <summary>
    /// Choosing a tab, even the one already open, is also how a screen that failed inside the
    /// boundary is left: the boundary drops its error before the chosen screen is drawn.
    /// </summary>
    private void ShowTab(AppTab tab)
    {
        _boundary?.Recover();
        Tabs.Show(tab);
    }

    /// <summary>Called by shell.js when the window widens past the phone layout, where More has no place.</summary>
    [JSInvokable]
    public void OnWideLayout() => Tabs.CloseMore();

    private void ToggleMore()
    {
        Tabs.ToggleMore();
        _focusFirstMoreItem = Tabs.MoreOpen;
    }

    private void CloseMoreAndReturnFocus()
    {
        Tabs.CloseMore();
        _focusMoreButton = true;
    }

    /// <summary>Called by shell.js on Escape anywhere in the document while the More panel is in the DOM.</summary>
    [JSInvokable]
    public void OnEscape()
    {
        if (Tabs.MoreOpen)
        {
            CloseMoreAndReturnFocus();
        }
    }

    protected override void OnInitialized() => Tabs.Changed += OnTabChanged;

    /// <summary>
    /// Redraws when something outside this component changes the tab. Through InvokeAsync and
    /// behind the same _disposed check the lock poll uses, so a change arriving as the window closes
    /// cannot render a disposed component.
    /// </summary>
    private void OnTabChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            _boundary?.Recover();
            StateHasChanged();
        }
    });

    protected override async Task OnInitializedAsync()
    {
        StartupLog.Write("Shell: OnInitializedAsync entered");

        try
        {
            await Model.RefreshAsync(_lifetime.Token);
        }
        catch (Exception e)
        {
            StartupLog.Write("Shell: RefreshAsync failed", e);
            _failure = e.Message;
            return;
        }

        StartupLog.Write($"Shell: refreshed, stage {Model.Stage}");
        _ready = true;

        // Started only once the first refresh has run, so a tick can never race the initial Stage.
        _lockPollTimer = new Timer(OnLockPollTick, state: null, PollInterval, PollInterval);
    }

    private void OnLockPollTick(object? state)
    {
        // The same disposal discipline RevealSeed.razor documents: Timer.Dispose does not wait for
        // a callback already running on a thread-pool thread, so the _disposed check has to happen
        // inside a delegate the renderer's own dispatcher runs -- that delegate and Dispose() are
        // then ordered against each other, and a render can never land on a disposed component.
        _ = InvokeAsync(async () =>
        {
            if (_disposed || !Model.NoticeLock())
            {
                return;
            }

            Tabs.Show(AppTab.Keys);

            // One file read, here, rather than one per tick: NoticeLock deliberately leaves
            // DeviceUnlockOffered alone, and the unlock screen this is about to show needs it.
            try
            {
                await Model.RefreshAsync(_lifetime.Token);
            }
            catch (OperationCanceledException) when (_lifetime.Token.IsCancellationRequested)
            {
                return;
            }
            catch (Exception e)
            {
                // Nothing observes this task, so a failure is logged here or nowhere. The vault
                // file could not be read (a sync client holding it, an unplugged volume); NoticeLock
                // already set Stage to Locked, so the unlock screen is still the right one to draw.
                // DeviceUnlockOffered keeps whatever the last successful read left, and a device
                // unlock that finds no wrap reports that outcome itself.
                StartupLog.Write("Shell: RefreshAsync after a lock failed", e);
            }

            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task LockAsync()
    {
        await Model.LockAsync();
        Tabs.Show(AppTab.Keys);
        StateHasChanged();
    }

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason RevealSeed.razor's own Dispose explains.
        _disposed = true;
        Tabs.Changed -= OnTabChanged;
        _self?.Dispose();
        _lockPollTimer?.Dispose();
        _lifetime.End();
    }
}
