@using XrplFile.App
@implements IDisposable
@inject PublishModel Model
@inject RunModel Run

@* Design 4.1 and F13: the Publish tab renders exactly one of its three stops -- the running/finished
   screen once a run exists, the estimate once one has been taken, or the picker below -- and every
   fact on screen is read straight off PublishModel or RunModel. Whether a run is active at all is
   RunModel.IsActive's own decision, not this markup's: it used to compare
   Run.Snapshot.State != PublicationRunState.Idle directly against the service PublicationRun,
   reaching past the model and putting a comparison nothing here can test into markup. The only thing
   this component still decides for itself is which of the three stops is on screen, which is
   navigation, not a fact about the publication; KeyList.razor's own remarks make the same distinction
   for its own sub-screens.

   The one-second timer exists only to make PublicationRun's own background progress visible: its
   Snapshot changes on a task this screen never awaits, and without a poll forcing a render, <Run />
   would go on showing whatever it read at its last user-triggered render. Copied verbatim from
   Shell.razor's own poll, at the same interval and with the same Timer/ScreenLifetime/
   _disposed shape, so the two screens can never notice a change at different moments. Dismissing a
   run from <Run /> also calls StateHasChanged directly, through OnDismissed, rather than waiting on
   this same poll: without it, this branch would go on showing <Run /> — now re-rendering itself
   against a freshly Idle snapshot — for up to a second after the button was pressed. *@

@if (Run.IsActive)
{
    <Run OnDismissed="StateHasChanged" />
}
else if (_estimated)
{
    <Estimate Request="_request!" OnBack="() => _estimated = false" OnStarted="Started" />
}
else
{
    <div class="xf-page">
        <h1 class="xf-title">Publish a file</h1>

        <section class="xf-card">
            <button type="button" class="btn btn-outline-primary" @onclick="PickAsync">Choose a file&hellip;</button>

            @if (Model.FileName is not null)
            {
                <p class="mt-2">@Model.FileName &mdash; @Model.FileSize.ToString("N0") bytes</p>
            }

            <div class="list-group mt-3">
                @foreach (VaultEntryInfo key in Model.Keys)
                {
                    <button type="button" class="list-group-item list-group-item-action @(Model.IsSelected(key) ? "active" : "")"
                            @onclick="() => SelectKeyAsync(key.Reference)">
                        <span>@key.Label &mdash; <span class="xf-mono">@key.Address</span> (@key.Network)</span>
                    </button>
                }
            </div>

            @if (Model.SelectedKey is not null)
            {
                <label class="form-label mt-3" for="xf-payer">Paid by</label>
                <select id="xf-payer" class="form-select" disabled="@Model.PayerLocked"
                        value="@(Model.SelectedPayer?.Reference ?? string.Empty)" @onchange="OnPayerChanged">
                    @foreach (VaultEntryInfo payer in Model.PayerChoices)
                    {
                        <option value="@payer.Reference">@payer.Label &mdash; @payer.Address</option>
                    }
                    <option value="">@PublishModel.NobodyLabel</option>
                </select>
                @if (Model.PayerNote is { } note)
                {
                    <p class="xf-muted small mt-1 mb-0">@note</p>
                }
            }
        </section>

        @if (Model.Message is not null)
        {
            <div class="alert alert-warning">@Model.Message</div>
        }

        @if (Model.Warning is not null)
        {
            <div class="alert alert-secondary">@Model.Warning</div>
        }

        <button type="button" class="btn btn-primary" disabled="@(!Model.CanEstimate)" @onclick="EstimateAsync">
            Estimate
        </button>
    </div>

    <Unfinished />
}

@code {
    /// <summary>
    /// How often this screen forces a render while a run may be progressing. Matches Shell.razor's
    /// own poll -- see that component's own remarks on why the two must agree.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly ScreenLifetime _lifetime = new();
    private Timer? _pollTimer;
    private bool _disposed;
    private bool _estimated;
    private PublishRequest? _request;

    protected override async Task OnInitializedAsync()
    {
        await Model.RefreshKeysAsync(_lifetime.Token);
        await Model.RefreshPayerAsync(_lifetime.Token);

        // Started only once the first refresh has run, matching Shell.razor's own reasoning: a tick
        // can then never race the first render.
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);
    }

    private void OnPollTick(object? state)
    {
        // Same disposal discipline as Shell.razor's own poll: Timer.Dispose does not wait for a
        // callback already running on a thread-pool thread, so _disposed is checked inside the
        // delegate the renderer's own dispatcher runs, which orders that check against Dispose().
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            StateHasChanged();
        });
    }

    private async Task SelectKeyAsync(string reference)
    {
        Model.SelectKey(reference);
        await Model.RefreshPayerAsync(_lifetime.Token);
    }

    private void OnPayerChanged(ChangeEventArgs change) => Model.SelectPayer(change.Value as string);

    private async Task PickAsync()
    {
        await Model.PickFileAsync(_lifetime.Token);

        if (Model.LastPickerFailure is { } failure)
        {
            StartupLog.Write("Publish: the file dialog failed", failure);
        }
    }

    private async Task EstimateAsync()
    {
        PublishRequest? request = await Model.BuildRequestAsync(_lifetime.Token);
        if (request is null)
        {
            return;
        }

        _request = request;
        _estimated = true;
    }

    /// <summary>
    /// Estimate.razor's own OnStarted, fired once PublicationRun.Start has been called. Returns this
    /// screen to the picker underneath -- not to the estimate, which described a request that has
    /// already been handed off -- so a Dismiss on the run screen that follows finds a fresh start
    /// rather than a stale estimate.
    /// </summary>
    private void Started()
    {
        _estimated = false;
    }

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason Shell.razor's own Dispose explains.
        _disposed = true;
        _pollTimer?.Dispose();
        _lifetime.End();
    }
}
