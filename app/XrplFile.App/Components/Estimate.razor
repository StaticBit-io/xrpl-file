@implements IAsyncDisposable
@inject EstimateModel Model
@inject PublicationRun Run
@inject PublishModel Picker

@* Design 4.2: what a publication will cost, before it is agreed to. Every figure below is
   EstimateModel.Estimate's own; this component decides only whether to show the alert CanPublish and
   Message already settled, never the numbers behind either. This is also the last screen before
   money is spent, so what file and which key -- both already settled in Request, by PublishModel,
   before this component ever existed -- are named here too, not only the cost. *@

<div class="xf-page">
    <h1 class="xf-title">@T[EstimateText.Title]</h1>

    <p>
        @Html(UiText.Of(EstimateText.Publishing, ("name", Request.Name), ("size", UiText.Of(CommonText.Bytes, ("count", (Model.Request ?? Request).Size))), ("account", Request.Account)), ("name", "strong"), ("account", "code"))
    </p>

    @if (Model.BatchEstimate is { } batch)
    {
        <section class="xf-card">
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowChunks]</th><td>@T.Number(batch.Chunks)</td></tr>
                    <tr><th>@T[EstimateText.RowBatches]</th><td>@T.Number(batch.Batches)</td></tr>
                    <tr><th>@T[EstimateText.RowSoloTransactions]</th><td>@T.Number(batch.SoloTransactions)</td></tr>
                    <tr><th>@T[EstimateText.RowFeeUnit]</th><td>@T[UiText.Of(EstimateText.Drops, ("count", batch.FeeUnitDrops))]</td></tr>
                </tbody>
            </table>

            <h2 class="xf-section-title mt-4">@Html(UiText.Of(EstimateText.PayerHeading, ("label", Request.PayerLabel ?? string.Empty), ("account", Request.PayerAccount ?? string.Empty)), ("account", "code"))</h2>
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowFees]</th><td>@T.Xrp(batch.PayerFeeDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowFeesWorstCase]</th><td>@T.Xrp(batch.PayerFeeDropsWorstCase)</td></tr>
                    <tr><th>@T[EstimateText.RowAccountReserve]</th><td>@T.Xrp(batch.BaseReserveDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowRequired]</th><td>@T.Xrp(batch.PayerRequiredDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowBalance]</th><td>@T.Xrp(batch.PayerBalanceDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowSpendable]</th><td>@T.Xrp(batch.PayerSpendableDrops)</td></tr>
                </tbody>
            </table>

            <h2 class="xf-section-title mt-4">@Html(UiText.Of(EstimateText.WriterHeading, ("label", Request.WriterLabel ?? string.Empty), ("account", Request.Account)), ("account", "code"))</h2>
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowFees]</th><td>@T.Xrp(batch.WriterFeeDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowFeesWorstCase]</th><td>@T.Xrp(batch.WriterFeeDropsWorstCase)</td></tr>
                    <tr><th>@T[EstimateText.RowAccountReserve]</th><td>@T.Xrp(batch.BaseReserveDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowRequired]</th><td>@T.Xrp(batch.WriterRequiredDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowBalance]</th><td>@T.Xrp(batch.WriterBalanceDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowSpendable]</th><td>@T.Xrp(batch.WriterSpendableDrops)</td></tr>
                </tbody>
            </table>

            @if (Model.Summary is { } summary)
            {
                <table class="table xf-kv-table mt-4">
                    <tbody>
                        <tr><th>@T[EstimateText.RowTime]</th><td>@T[DurationText.Of(summary.Duration)]</td></tr>
                    </tbody>
                </table>
            }

            <p class="mt-3 mb-0">@T[Model.MethodLine]</p>
            <p class="mt-3 mb-0 xf-muted">@Html(UiText.Of(EstimateText.NodeLine, ("url", Model.NodeUrl ?? string.Empty), ("network", Request.Network)), ("url", "code"))</p>
        </section>
    }
    else if (Model.Estimate is { } estimate)
    {
        <section class="xf-card">
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowChunks]</th><td>@T.Number(estimate.Chunks)</td></tr>
                    <tr><th>@T[EstimateText.RowTransactions]</th><td>@T.Number(estimate.Transactions)</td></tr>
                    <tr><th>@T[EstimateText.RowFeePerTransaction]</th><td>@T[UiText.Of(EstimateText.Drops, ("count", estimate.FeeDropsPerTransaction))]</td></tr>
                </tbody>
            </table>

            <h2 class="xf-section-title mt-4">@T[EstimateText.SpentTitle]</h2>
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowFees]</th><td>@T.Xrp(estimate.FeeDropsTotal)</td></tr>
                    <tr><th>@T[EstimateText.RowFeesRetried]</th><td>@T.Xrp(estimate.FeeDropsWorstCase)</td></tr>
                </tbody>
            </table>

            <h2 class="xf-section-title mt-4">@T[EstimateText.HeldTitle]</h2>
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowTicketReserve]</th><td>@T.Xrp(estimate.PeakReserveDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowAccountReserve]</th><td>@T.Xrp(estimate.BaseReserveDrops)</td></tr>
                </tbody>
            </table>
            <p class="xf-muted small mb-0">@T[EstimateText.AccountReserveStays]</p>

            <table class="table xf-kv-table mt-4">
                <tbody>
                    <tr><th>@T[EstimateText.RowRequired]</th><td>@T.Xrp(estimate.RequiredDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowAccountBalance]</th><td>@T.Xrp(estimate.BalanceDrops)</td></tr>
                    <tr><th>@T[EstimateText.RowSpendable]</th><td>@T.Xrp(estimate.SpendableDrops)</td></tr>
                </tbody>
            </table>

            @if (Model.Summary is { } summary)
            {
                <table class="table xf-kv-table mt-4">
                    <tbody>
                        <tr><th>@T[EstimateText.RowTime]</th><td>@T[DurationText.Of(summary.Duration)]</td></tr>
                    </tbody>
                </table>
            }

            <p class="mt-3 mb-0 xf-muted">@Html(UiText.Of(EstimateText.NodeLine, ("url", Model.NodeUrl ?? string.Empty), ("network", Request.Network)), ("url", "code"))</p>
            @if (Model.Note is { } note)
            {
                <p class="mt-2 mb-0 xf-muted small">@T[note]</p>
            }
        </section>
    }

    @* A message means the estimate cannot be published whatever is ticked, so there is nothing to agree to. *@
    @if (Model.NeedsConfirmation && Model.Message is null && Model.Summary is { } confirm)
    {
        <section class="xf-card">
            <h2 class="xf-section-title">@T[EstimateText.LargeTitle]</h2>
            <table class="table xf-kv-table">
                <tbody>
                    <tr><th>@T[EstimateText.RowTime]</th><td>@T[DurationText.Of(confirm.Duration)]</td></tr>
                    <tr><th>@T[EstimateText.RowTransactions]</th><td>@T.Number(confirm.Transactions)</td></tr>
                    @foreach (AccountCost account in confirm.Accounts)
                    {
                        <tr><th>@T[account.NeedsLabel]</th><td>@T.Xrp(account.RequiredDrops)</td></tr>
                        <tr><th>@T[account.WorstCaseFeesLabel]</th><td>@T.Xrp(account.WorstCaseFeeDrops)</td></tr>
                    }
                </tbody>
            </table>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="xf-understood" checked="@Model.Confirmed"
                       @onchange="change => Model.Confirm(change.Value is true)" />
                <label class="form-check-label" for="xf-understood">@T[EstimateText.ConfirmationLabel]</label>
            </div>
        </section>
    }

    @if (Model.Message is not null)
    {
        <div class="alert alert-warning">@T[Model.Message]</div>
    }

    @if (_notice is not null)
    {
        <div class="alert alert-warning">@T[_notice]</div>
    }

    <div class="xf-actionbar">
        <button type="button" class="btn btn-outline-secondary" disabled="@_starting" @onclick="Back">@T[EstimateText.BackButton]</button>
        <button type="button" class="btn btn-primary" disabled="@(!Model.CanPublish || _starting)" @onclick="PublishAsync">
            @T[EstimateText.PublishButton]
        </button>
    </div>
</div>

@code {
    private readonly ScreenLifetime _lifetime = new();
    private bool _starting;
    private UiText? _notice;

    [Parameter, EditorRequired]
    public PublishRequest Request { get; set; } = null!;

    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Fired once <see cref="PublicationRun.Start"/> has actually been called.</summary>
    [Parameter]
    public EventCallback OnStarted { get; set; }

    protected override async Task OnInitializedAsync() => await Model.EstimateAsync(Request, _lifetime.Token);

    private Task Back() => OnBack.InvokeAsync();

    private async Task PublishAsync()
    {
        if (_starting || !Model.CanPublish)
        {
            return;
        }

        _starting = true;
        try
        {
            // False here would mean a run is already going, which reaching this screen through
            // Publish.razor already rules out: that screen only ever shows this one when
            // RunModel.IsRunning is false. Nothing further is done with the result -- Publish.razor's
            // own poll notices IsRunning flip and swaps to <Run /> within one second either way.
            // The estimated request, not the parameter: EstimateModel may have dropped a payer that
            // would have paid for nothing (PublishPolicy.Effective), and the run must be what was priced.
            // It comes with the file the estimate held and the approval it made (spec S24, S25).
            PublishRequest? request = Model.HandOff();
            if (request is null)
            {
                // The held file is gone: the estimate was discarded or taken while this screen was still showing it.
                _notice = EstimateText.NothingReady;
                return;
            }

            _notice = null;

            // A run that refused the start did not take the file, so it is let go here.
            if (Run.Start(request)) Picker.RecordStarted(request);
            else await request.Source!.DisposeAsync();

            await OnStarted.InvokeAsync();
        }
        finally
        {
            _starting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.End();

        // Leaving the screen lets the held file go (spec S24); a run that took it already owns it.
        await Model.DiscardAsync();
    }
}
