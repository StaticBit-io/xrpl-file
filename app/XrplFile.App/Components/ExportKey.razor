@implements IDisposable
@inject ExportModel Model
@inject IJSRuntime JS

@* Design section 8: a container sealed under its own password, offered as a file or as a QR code.
   ExportModel.ToContainerAsync and ToQr do every byte of the work and every decision about whether a
   code fits; this component only calls them and draws what QrPayload.FitsOneCode already said.
   Every word of failure on this screen is Model.Problem, including the refusal of a backup password
   that is too short -- the minimum, and whether a given password meets it, is PasswordPolicy's and
   ExportModel's decision, never this markup's. The button stays live so a press explains itself
   rather than going inert with nothing said. *@

@if (_container is null)
{
    <h1 class="xf-title">Export key</h1>
    <p>
        Exporting writes a portable backup file, protected by its own password &mdash; separate from
        the vault's master password. Anyone who has both the file (or the code below) and this
        password can spend from this account.
    </p>

    @if (Model.Problem is { } problem)
    {
        <div class="alert alert-danger">@problem</div>
    }

    <section class="xf-card">
        <div class="mb-3">
            <label class="form-label">Backup password</label>
            <input type="password" class="form-control" @bind="_password" @bind:event="oninput" disabled="@_busy" />
        </div>

        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">Create backup</button>
    </section>
    <button type="button" class="btn btn-outline-secondary" @onclick="BackAsync">Skip for now</button>
}
else
{
    <div class="alert alert-success">
        Backup created. It is not saved anywhere yet &mdash; save it to a file, or scan the code,
        before leaving this screen.
    </div>

    @if (Model.Problem is { } saveProblem)
    {
        <div class="alert alert-danger">@saveProblem</div>
    }

    @if (_saved)
    {
        <div class="alert alert-info">Saved.</div>
    }

    <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="SaveToFileAsync">
        Save to file&hellip;
    </button>
    <button type="button" class="btn btn-outline-primary ms-2" @onclick="ShowQr">Show as QR code</button>

    @if (_showQr)
    {
        @if (_qr is { FitsOneCode: true })
        {
            @* A long press on an <img> in a WKWebView offers "Add to Photos", and an unencrypted
               code would go to the photo gallery and iCloud around every restriction ExportModel
               applies. Drawn into a <canvas>, never an <img src="data:...">, and its container
               carries -webkit-touch-callout: none for the same reason. Windows has no such gesture
               today, but this markup is shared with a future mobile target and the day it runs there
               must not be the day this is discovered. *@
            <div class="mt-3" style="-webkit-touch-callout: none; display: inline-block;">
                <canvas @ref="_qrCanvas"></canvas>
            </div>
        }
        else if (_qr is not null)
        {
            <div class="alert alert-warning mt-3">
                This key's backup is too large for a single QR code. Use the file instead &mdash;
                splitting a backup across several codes is not supported.
            </div>
        }
    }

    <div class="mt-3">
        <button type="button" class="btn btn-outline-secondary" @onclick="BackAsync"><BackIcon /> Back to keys</button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Reference { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private string _password = string.Empty;
    private byte[]? _container;
    private QrPayload? _qr;
    private bool[][]? _pendingMatrix;
    private bool _showQr;
    private bool _saved;
    private bool _busy;
    private ElementReference _qrCanvas;

    private async Task CreateAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        byte[] passwordBytes = Encoding.UTF8.GetBytes(_password);
        try
        {
            _container = await Model.ToContainerAsync(Reference, passwordBytes, _cts.Token);
        }
        finally
        {
            CryptographicOperations.ZeroMemory(passwordBytes);
            _busy = false;
        }

        // Cleared only once a container actually exists. A refused password has to stay in the
        // field: blanking it would leave the person retyping from scratch against a rule they have
        // only just been told about.
        if (_container is not null)
        {
            _password = string.Empty;
        }
    }

    private async Task SaveToFileAsync()
    {
        if (_container is null || _busy)
        {
            return;
        }

        _busy = true;
        // Reset on every attempt, not just a successful one: without this, a save that fails after
        // an earlier save succeeded still showed "Saved." alongside the new failure alert, because
        // nothing ever told this flag the earlier success no longer describes what just happened.
        _saved = false;
        StateHasChanged();
        try
        {
            // The entry is marked exported only once the platform actually wrote the bytes, and
            // what a platform failure means -- report it, or let it crash -- is Model.SaveToFileAsync's
            // decision, not this markup's; see its own remarks for why.
            _saved = await Model.SaveToFileAsync(Reference, _container, _cts.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowQr()
    {
        if (_container is null)
        {
            return;
        }

        _qr = Model.ToQr(_container);
        _showQr = true;

        // The error correction level is fixed at H inside QrMatrix.Build; there is no parameter
        // here to lower it, matching design section 8's "never quietly lowered". Only computed when
        // it fits one code -- QrPayload.FitsOneCode already answered whether a code should be drawn
        // at all, before any encoder ran on the mobile side.
        _pendingMatrix = _qr.FitsOneCode ? QrMatrix.Build(_qr.Text) : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingMatrix is { } matrix)
        {
            _pendingMatrix = null;
            await JS.InvokeVoidAsync("drawQrMatrix", _cts.Token, _qrCanvas, matrix);
        }
    }

    private async Task BackAsync()
    {
        if (_showQr && _qr is { FitsOneCode: true })
        {
            await JS.InvokeVoidAsync("clearQrCanvas", _cts.Token, _qrCanvas);
        }

        await OnBack.InvokeAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
