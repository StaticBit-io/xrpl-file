@implements IDisposable
@inject UnlockModel Model

@* The one screen design section 6 says "must state the consequence plainly" — not a footnote under
   the field, the second paragraph of the page itself, ahead of the form.
   Every word in the message panel below is the model's: UnlockModel.CreateAsync already turned any
   failure into a CreateMessage's headline and detail (CreateMessages.For), so this component only
   ever binds to Model.LastCreateMessage. It never reads an exception, and never composes a sentence
   of its own — the same rule Unlock.razor follows for Model.LastMessage. *@

<div class="xf-vault">
    <section class="xf-card">
        <h1 class="xf-title">Create your vault</h1>

        <p>
            This is the first time this application has run here, and there is nothing to open yet.
        </p>

        <p>
            <strong>There is no recovery phrase.</strong> The master password you choose below is the
            only way this vault will ever open. If it is forgotten, every key inside that was not
            individually exported is gone for good &mdash; there is no support process, no reset link
            and no backdoor that gets it back.
        </p>

        @if (Model.LastCreateMessage is { } message)
        {
            <div class="alert alert-danger" role="alert">
                <strong>@message.Headline</strong>
                <div>@message.Detail</div>
            </div>
        }

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="mb-3">
                <label for="new-password" class="form-label">Master password</label>
                <input id="new-password" type="password" class="form-control" autofocus
                       @bind="_password" @bind:event="oninput" disabled="@_busy" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_busy">Create vault</button>
        </form>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private string _password = string.Empty;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        byte[] passwordBytes = Encoding.UTF8.GetBytes(_password);
        _password = string.Empty;
        try
        {
            await Model.CreateAsync(passwordBytes, _cts.Token);
        }
        finally
        {
            CryptographicOperations.ZeroMemory(passwordBytes);
            _busy = false;
        }

        await OnChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
