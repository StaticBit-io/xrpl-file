@implements IDisposable
@inject PasswordChangeModel Model

@* Design 6, "Changing the password": every flag VaultPasswordChange can set reaches the screen as
   its own sentence, through PasswordChangeModel.Describe -- ThingsToTell is already the full list in
   a fixed order, so this component only renders it. The one sentence this screen composes itself is
   the wrong-password case, because PasswordChangeReport deliberately carries none for it (see its
   own remarks: nothing was written, so there is nothing for the model to describe) -- the words here
   are fixed and tied to nothing but the boolean Changed already is, the same as Unlock.razor picking
   an alert's CSS class off CountsAsAFailedAttempt. A refusal -- a new password too short to be one
   -- carries its own words in PasswordChangeReport.Refusal, because "the current password is wrong"
   and "the new password is too short" send a person to opposite fields and a component must not be
   the thing that decides which of them a bare false means. *@

<BackLink To="Settings" OnClick="BackAsync" />
<h1 class="xf-title">Change master password</h1>

@if (_report is { } report)
{
    @if (report.Refusal is { } refusal)
    {
        <div class="alert alert-danger">@refusal</div>
    }
    else if (!report.Changed)
    {
        <div class="alert alert-danger">The current password is wrong. Nothing was changed.</div>
    }
    else
    {
        <div class="alert alert-success">
            <ul class="mb-0">
                @foreach (string sentence in report.ThingsToTell)
                {
                    <li>@sentence</li>
                }
            </ul>
        </div>
    }
}

@if (_report is not { Changed: true })
{
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <section class="xf-card">
            <div class="mb-3">
                <label for="change-old-password" class="form-label">Current password</label>
                <input id="change-old-password" type="password" class="form-control"
                       @bind="_oldPassword" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mb-3">
                <label for="change-new-password" class="form-label">New password</label>
                <input id="change-new-password" type="password" class="form-control"
                       @bind="_newPassword" @bind:event="oninput" disabled="@_busy" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_busy">Change password</button>
        </section>
    </form>
}

<div class="mt-3">
</div>

@code {
    [Parameter]
    public EventCallback OnBack { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private bool _busy;
    private PasswordChangeReport? _report;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        byte[] oldPasswordBytes = Encoding.UTF8.GetBytes(_oldPassword);
        byte[] newPasswordBytes = Encoding.UTF8.GetBytes(_newPassword);
        _oldPassword = string.Empty;
        _newPassword = string.Empty;
        try
        {
            _report = await Model.ChangeAsync(oldPasswordBytes, newPasswordBytes, _lifetime.Token);
        }
        finally
        {
            CryptographicOperations.ZeroMemory(oldPasswordBytes);
            CryptographicOperations.ZeroMemory(newPasswordBytes);
            _busy = false;
        }
    }

    private async Task BackAsync() => await OnBack.InvokeAsync();

    public void Dispose()
    {
        _lifetime.End();
    }
}
