@implements IDisposable
@inject UnlockModel Model

@* Every word on this screen is the model's: UnlockMessages.For already turned the outcome into a
   headline and a detail sentence, so this component only ever binds to Model.LastMessage and
   Model.DeviceUnlockOffered. Whether a message panel or the device-unlock button is present is a
   presentational read of a fact the model already decided, not a decision made here. *@

<div class="xf-vault">
    <section class="xf-card">
        <h1 class="xf-title">Unlock your vault</h1>

        @if (Model.LastMessage is { } message)
        {
            <div class="alert @(message.CountsAsAFailedAttempt ? "alert-danger" : "alert-info")" role="alert">
                <strong>@message.Headline</strong>
                <div>@message.Detail</div>
            </div>
        }

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="mb-3">
                <label for="unlock-password" class="form-label">Master password</label>
                <input id="unlock-password" type="password" class="form-control" autofocus
                       @bind="_password" @bind:event="oninput" disabled="@_busy" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_busy">Unlock</button>

            @if (Model.DeviceUnlockOffered)
            {
                <button type="button" class="btn btn-outline-secondary ms-2" disabled="@_busy" @onclick="UnlockWithDeviceAsync">
                    Unlock with this device
                </button>
            }
        </form>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private string _password = string.Empty;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        byte[] passwordBytes = Encoding.UTF8.GetBytes(_password);
        _password = string.Empty;
        try
        {
            await Model.UnlockAsync(passwordBytes, _lifetime.Token);
        }
        finally
        {
            CryptographicOperations.ZeroMemory(passwordBytes);
            _busy = false;
        }

        await OnChanged.InvokeAsync();
    }

    private async Task UnlockWithDeviceAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            await Model.UnlockWithDeviceAsync(_lifetime.Token);
        }
        finally
        {
            _busy = false;
        }

        await OnChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _lifetime.End();
    }
}
