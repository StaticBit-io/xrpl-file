@implements IDisposable
@inject CloseAccountModel Model

@* Design 5.1: the careful screen. An AccountDelete sends everything the account holds and cannot
   be undone, and nothing here chooses a destination on its own (G3) -- Candidates and the typed
   address both only ever reach Model.ChooseDestination, and nothing is confirmable before
   Model.PreflightAsync has actually run (G5).

   Once Model.Preview says Ready, the confirmation shows the destination address in full -- never
   truncated, since a truncated address hides exactly the characters a typo lives in -- its current
   balance, which is how a person recognises the account they meant (G6), what will arrive, and the
   fee, plus fixed copy that the account will cease to exist and this cannot be undone. When the
   outcome is NotYet this screen shows the ledger it becomes possible from and offers no second
   button: waiting is never a reason to talk somebody into leaving the reserve behind forever (G11).
   Every other outcome is already a sentence in Model.Message -- CloseErrorMessages, not this markup,
   decides what a refusal means. *@

@if (Model.Closed is { } closed)
{
    <div class="alert alert-success">
        <p>
            Account closed. <strong>@closed.ArrivedDrops.ToString("N0") drops</strong> was sent to
            <span class="user-select-all">@closed.Destination</span>.
        </p>
        <p>Transaction hash: <code class="user-select-all">@closed.TxHash</code></p>
    </div>

    <button type="button" class="btn btn-link" @onclick="BackAsync">Back to accounts</button>
}
else
{
    <h1 class="h3">Close account</h1>

    <p>
        Closing sends everything this account holds to a destination you choose.
        <strong>The account will cease to exist, and this cannot be undone.</strong>
    </p>

    @if (Model.Message is not null)
    {
        <div class="alert alert-warning">@Model.Message</div>
    }

    <div class="mb-3">
        <label class="form-label">Send the remainder to</label>

        @if (Model.Candidates.Count > 0)
        {
            <ul class="list-group mb-2">
                @foreach (VaultEntryInfo candidate in Model.Candidates)
                {
                    <li class="list-group-item @(string.Equals(Model.Destination, candidate.Address, StringComparison.Ordinal) ? "active" : "")"
                        @onclick="() => Model.ChooseDestination(candidate.Address)">
                        @candidate.Label &mdash; @candidate.Address (@candidate.Network)
                    </li>
                }
            </ul>
        }

        <input class="form-control" placeholder="Or type an address" disabled="@_busy"
               value="@Model.Destination" @oninput="e => Model.ChooseDestination((string)e.Value!)" />
    </div>

    <button type="button" class="btn btn-outline-primary" disabled="@(Model.Destination is null || _busy)"
            @onclick="PreflightAsync">
        Check
    </button>

    @if (Model.Preview is { Outcome: DeletionOutcome.Ready } ready)
    {
        <div class="alert alert-info mt-3">
            <p>
                This will send everything this account holds to
                <strong class="user-select-all">@Model.Destination</strong>, which currently holds
                @Model.DestinationBalanceDrops.ToString("N0") drops.
            </p>
            <table class="table mb-2">
                <tbody>
                    <tr><th>Fee</th><td>@ready.FeeDrops.ToString("N0") drops</td></tr>
                    <tr><th>Arriving</th><td>@ready.ArrivingDrops.ToString("N0") drops</td></tr>
                </tbody>
            </table>
            <p><strong>The account will cease to exist once this is sent. This cannot be undone.</strong></p>
            <button type="button" class="btn btn-danger" disabled="@(!Model.CanClose || _busy)" @onclick="CloseAsync">
                Close permanently
            </button>
        </div>
    }
    else if (Model.Preview is { Outcome: DeletionOutcome.NotYet } notYet)
    {
        <div class="alert alert-secondary mt-3">
            It cannot be closed yet. It becomes possible from ledger
            <strong>@notYet.DeletableFromLedger</strong>.
        </div>
    }

    <div class="mt-3">
        <button type="button" class="btn btn-link" @onclick="BackAsync">Back to accounts</button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Reference { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _busy;

    protected override async Task OnInitializedAsync() => await Model.SelectAsync(Reference, _cts.Token);

    private async Task PreflightAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            await Model.PreflightAsync(_cts.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            await Model.CloseAsync(_cts.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task BackAsync() => OnBack.InvokeAsync();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
