@implements IDisposable
@inject CloseAccountModel Model

@* Design 5.1: the careful screen. An AccountDelete sends everything the account holds and cannot
   be undone, and nothing here chooses a destination on its own (G3) -- Candidates and the typed
   address both only ever reach Model.ChooseDestination, and nothing is confirmable before
   Model.PreflightAsync has actually run (G5).

   An imported key may be an account the person still uses, so the model supplies one extra warning
   line for it (ImportedWarning, null for a generated one), shown above the destination choice and so
   before any confirm step; the recipient is named explicitly for both kinds, with no default.

   The account this whole screen is about to destroy is named up front -- label and address, from
   Model.AccountLabel/AccountAddress, plus its balance once a preflight has read it -- because this
   is reached from a list of near-identical account rows and the destination side alone being done
   properly does not tell a person which source account they are looking at.

   CloseAccountModel is a singleton, like FundingModel, and can still be holding a PREVIOUS account's
   Closed outcome (or Preview, or AccountAddress) at the moment this component first paints for a
   new one -- SelectAsync resets those fields, but nothing about a synchronous-looking reset is a
   render-ordering guarantee on every host this runs on. Ready mirrors Funding.razor's own gate for
   exactly that reason: it compares Model.CurrentReference, set only once SelectAsync has actually
   resolved data for THIS component's own Reference, so the previous account's success panel cannot
   render even for one frame. Model.Message is still shown unconditionally above that gate, the same
   way Funding.razor shows its own, so a failed select's explanation is never hidden behind it.

   Once Model.Preview says Ready, the confirmation shows the destination address in full -- never
   truncated, since a truncated address hides exactly the characters a typo lives in -- its current
   balance, which is how a person recognises the account they meant (G6), what will arrive, and the
   fee, plus fixed copy that the account will cease to exist and this cannot be undone. When the
   outcome is NotYet this screen shows the ledger it becomes possible from, how many ledgers that is
   from here, and roughly how long that is (Model.LedgersRemaining / Model.TimeRemainingDescription
   -- a ledger number alone gives a person only one of the two numbers the wait needs, and "not yet"
   without a sense of scale reads as "never"), and offers no second button: waiting is never a reason
   to talk somebody into leaving the reserve behind forever (G11). Every other outcome is already a
   sentence in Model.Message -- CloseErrorMessages, not this markup, decides what a refusal means.

   Every button that can start a network round trip is disabled while _busy, Back to accounts
   included: this is the one screen in the application where letting a person navigate away mid-call
   is not merely inconvenient -- CloseAsync may already have put a signed AccountDelete on the wire,
   and disposing this component cancels the token it is awaiting on. The shell's rail, tab bar and
   Lock button are held disabled for the same reason (Model.IsClosing), so Back is not the only way
   out that is shut. Should the screen go anyway (the vault auto-locking, the window closing), the
   outcome stays on this account's own state in the model, and selecting the account again shows it. *@

@if (Model.Message is not null)
{
    <div class="alert alert-warning">@T[Model.Message]</div>
}

@if (!Ready)
{
    <p>@T[ShellText.Loading]</p>
}
else if (Model.Closed is { } closed)
{
    <div class="alert alert-success">
        <p class="xf-pick-code">
            @Html(UiText.Of(CloseText.ClosedSummary, ("amount", new XrpAmount(closed.ArrivedDrops)), ("destination", closed.Destination)), ("amount", "strong"), ("destination", "code"))
        </p>
        <p class="xf-pick-code">@Html(UiText.Of(CloseText.TransactionHash, ("hash", closed.TxHash)), ("hash", "code"))</p>
    </div>

    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="BackAsync">@T[CommonText.Done]</button>
}
else
{
    <BackLink To="AppTab.Accounts" OnClick="BackAsync" Disabled="_busy" />
    <h1 class="xf-title">@T[CloseText.Title]</h1>

    @if (Model.AccountAddress is { } accountAddress)
    {
        <div class="alert alert-secondary">
            <strong>@T[CloseText.Closing]</strong> @Model.AccountLabel &mdash;
            <span class="user-select-all"><span class="xf-mono">@accountAddress</span></span>
            @if (Model.Preview is { } holding)
            {
                <span> @T[UiText.Of(CloseText.CurrentlyHolds, ("amount", new XrpAmount(holding.BalanceDrops)))]</span>
            }
        </div>
    }

    @if (Model.ImportedWarning is { } importedWarning)
    {
        <div class="alert alert-warning">@T[importedWarning]</div>
    }

    <p>
        @T[CloseText.Intro]
        <strong>@T[CloseText.IntroWarning]</strong>
    </p>

    <section class="xf-card">
        <div class="mb-3">
            <label class="form-label">@T[CloseText.SendRemainderLabel]</label>

            @if (Model.Candidates.Count > 0)
            {
                <div class="xf-choice-list mb-2" role="radiogroup" aria-label="@T[CloseText.YourAccountsLabel]">
                    @foreach (VaultEntryInfo candidate in Model.Candidates)
                    {
                        bool chosen = string.Equals(Model.Destination, candidate.Address, StringComparison.Ordinal);
                        <button type="button" disabled="@_busy" role="radio" aria-checked="@(chosen ? "true" : "false")"
                                class="xf-choice @(chosen ? "is-selected" : null)"
                                @onclick="() => Model.ChooseDestination(candidate.Address)">
                            <span class="xf-choice-mark" aria-hidden="true"></span>
                            <span class="xf-choice-body">
                                <span class="xf-choice-title">@candidate.Label</span>
                                <span class="xf-mono xf-choice-sub">@candidate.Address</span>
                            </span>
                            <span class="xf-net @(candidate.Network == "mainnet" ? "is-mainnet" : null)">@candidate.Network</span>
                        </button>
                    }
                </div>
            }

            <input class="form-control" placeholder="@T[CloseText.AddressPlaceholder]" disabled="@_busy"
                   value="@Model.Destination" @oninput="e => Model.ChooseDestination((string)e.Value!)" />
        </div>

        <button type="button" class="btn btn-outline-primary" disabled="@(!Model.CanPreflight || _busy)"
                @onclick="PreflightAsync">
            @T[CloseText.CheckButton]
        </button>
    </section>

    @if (Model.Preview is { Outcome: DeletionOutcome.Ready } ready)
    {
        <div class="alert alert-info mt-3">
            <p class="xf-pick-code xf-bold-code">
                @Html(UiText.Of(CloseText.ConfirmSend, ("destination", Model.Destination ?? string.Empty), ("balance", new XrpAmount(Model.DestinationBalanceDrops))), ("destination", "code"))
            </p>
            <table class="table mb-2 xf-kv-table">
                <tbody>
                    <tr><th>@T[CloseText.FeeLabel]</th><td>@XrpAmount.Format(ready.FeeDrops)</td></tr>
                    <tr><th>@T[CloseText.ArrivingLabel]</th><td>@XrpAmount.Format(ready.ArrivingDrops)</td></tr>
                </tbody>
            </table>
            <p><strong>@T[CloseText.ConfirmWarning]</strong></p>
            <button type="button" class="btn btn-danger" disabled="@(!Model.CanClose || _busy)" @onclick="CloseAsync">
                @T[CloseText.ClosePermanentlyButton]
            </button>
        </div>
    }
    else if (Model.Preview is { Outcome: DeletionOutcome.NotYet } notYet)
    {
        @if (notYet.DeletableFromLedger is { } deletableFrom)
        {
            <div class="alert alert-secondary mt-3">
                <p>@Html(UiText.Of(CloseText.NotYetLedger, ("ledger", deletableFrom)), ("ledger", "strong"))</p>
                @if (Model.LedgersRemaining is { } remaining)
                {
                    <p>
                        @if (Model.TimeRemainingDescription is { } timeRemaining)
                        {
                            @T[UiText.Of(CloseText.LedgersRemainingWithTime, ("count", remaining), ("time", timeRemaining))]
                        }
                        else
                        {
                            @T[UiText.Of(CloseText.LedgersRemaining, ("count", remaining))]
                        }
                    </p>
                }
            </div>
        }
    }

}

@code {
    [Parameter, EditorRequired]
    public string Reference { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private bool _busy;

    /// <summary>
    /// Whether Model's data is actually resolved for THIS component's own Reference -- read live off
    /// the model, the same way Funding.razor's own Ready is, rather than cached in a field set once
    /// at the end of OnInitializedAsync.
    /// </summary>
    private bool Ready => string.Equals(Model.CurrentReference, Reference, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync() => await Model.SelectAsync(Reference, _lifetime.Token);

    private async Task PreflightAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            await Model.PreflightAsync(_lifetime.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            await Model.CloseAsync(_lifetime.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task BackAsync() => OnBack.InvokeAsync();

    public void Dispose()
    {
        _lifetime.End();
    }
}
