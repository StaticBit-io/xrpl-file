@* The way back from a sub-screen, above its title where a person looks for it, naming the screen it
   returns to. Every sub-screen uses this one, so "back" sits in the same place everywhere. *@
<button type="button" class="xf-back" disabled="@Disabled" @onclick="OnClick">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
    @To
</button>

@code {
    /// <summary>The name of the screen this returns to, e.g. "Accounts".</summary>
    [Parameter, EditorRequired]
    public string To { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Held shut while the sub-screen has work in flight that leaving would orphan.</summary>
    [Parameter]
    public bool Disabled { get; set; }
}
