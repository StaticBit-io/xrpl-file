@implements IDisposable
@inject ReadModel Model
@inject ReadRun Run

@* Design 4.1 and 4.2: the Read tab. A running read is drawn alone (progress and Cancel), so it
   cannot be left by accident. Otherwise the entry screen is always there: the link box, the lookup
   and the Read button. A finished read (Snapshot.IsFinished: Succeeded, Failed or Cancelled) adds
   its outcome above them and stays there until the next Read replaces it. Nobody has to put it away
   first: a "Dismiss" button there was not seen as the way to a new read. Which branch draws is
   Snapshot's and Model's own decision; this markup only names it.

   A save that throws while the read itself succeeded leaves State at Succeeded with Failure set
   (ReadRun.SaveAsync never writes State) -- the Succeeded branch draws that sentence exactly like
   the Failed branch draws its own, because the next Read deletes the one copy of the file that was
   just read. The Save button is disabled while Snapshot.Saving is true, straight off the run:
   nothing destructive happens from a second click (SaveAsync's own generation guard, see its
   remarks), but a control is not left enabled for the duration of an operation this screen already
   knows is running.

   Snapshot is taken once, at the top of this render, into a local -- not read field by field -- for
   the same reason Run.razor takes RunModel.Capture() once: ReadRun runs the block loop on a
   background task this screen never awaits, so separate reads of State, BlocksDone and Failure could
   land on different instants of the same run and draw, for instance, a Cancel button over a result
   that already finished. Part C2 had to fix exactly that shape twice.

   The blocks-done and bytes-done progress uses the browser's own <progress> element with raw done/
   total values as its attributes rather than a computed percentage: ReadSnapshot carries no percent
   of its own (unlike RunView, whose Percent is PublicationRun's own computed field), and turning
   BlocksDone/BlocksTotal into a percentage here would be exactly the kind of decision this component
   is not supposed to make on its own.

   The one-second timer exists for the same reason as Publish.razor's and Shell.razor's own pollers:
   a run's Snapshot changes on a task this component never awaits, so nothing here repaints on
   progress without a render forced from outside it. Copied verbatim from Shell.razor's own poll, at
   the same interval and the same Timer/ScreenLifetime/_disposed shape, so every screen that
   polls agrees on when it looks again. *@

@{
    ReadSnapshot snapshot = Run.Snapshot;
}

@if (snapshot.State == ReadState.Running)
{
    <div class="xf-page">
        <h1 class="xf-title">@T[ReadText.RunningTitle]</h1>

        <section class="xf-card">
            <p>@T[UiText.Of(ReadText.ProgressBlocks, ("done", snapshot.BlocksDone), ("total", snapshot.BlocksTotal), ("count", snapshot.BlocksTotal))]</p>
            <progress class="w-100" value="@snapshot.BlocksDone" max="@snapshot.BlocksTotal"></progress>

            <p class="mt-3">@T[UiText.Of(ReadText.ProgressBytes, ("done", snapshot.BytesDone), ("total", snapshot.BytesTotal), ("count", snapshot.BytesTotal))]</p>
            <progress class="w-100" value="@snapshot.BytesDone" max="@snapshot.BytesTotal"></progress>
        </section>

        <div class="xf-actionbar">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@T[CommonText.Cancel]</button>
        </div>
    </div>
}
else
{
    // Taken once, the same reason Snapshot is taken once at the top of this whole render (see the
    // block comment above): ReadModel.LookUpAsync publishes Parsed, Manifest, NodeUrl and Message
    // together from a thread-pool continuation, and reading them one property at a time here could
    // land on different instants of the same or different lookups.
    ReadLookupSnapshot lookup = Model.Snapshot;

    <div class="xf-page">
        <h1 class="xf-title">@T[ReadText.Title]</h1>

        @if (snapshot.IsFinished)
        {
            @if (snapshot.State == ReadState.Succeeded)
            {
                <div class="alert alert-success">
                    <p class="mb-2">@T[snapshot.Name is { } name ? UiText.Of(ReadText.SucceededNamed, ("name", name)) : UiText.Of(ReadText.Succeeded)]</p>
                    <button type="button" class="btn btn-outline-secondary" disabled="@snapshot.Saving" data-tour="@TutorialRegions.ReadSave" @onclick="SaveAsync">
                        @T[ReadText.SaveButton]
                    </button>
                    @if (snapshot.Saved)
                    {
                        <p class="mt-2 mb-0">@T[ReadText.Saved]</p>
                    }
                    @if (snapshot.Failure is not null)
                    {
                        <div class="alert alert-danger mt-2 mb-0">@T[snapshot.Failure]</div>
                    }
                </div>
            }
            else if (snapshot.State == ReadState.Failed)
            {
                <div class="alert alert-danger">@T[snapshot.Failure]</div>
            }
            else
            {
                <div class="alert alert-secondary">@T[ReadText.CancelledNote]</div>
            }
        }

        <section class="xf-card" data-tour="@TutorialRegions.ReadLink">
            <div class="mb-3">
                <label for="read-link" class="form-label">@T[ReadText.LinkLabel]</label>
                <input id="read-link" class="form-control xf-mono" @bind="Model.Link" @bind:event="oninput" />
            </div>

            <button type="button" class="btn btn-outline-primary" disabled="@Model.LookingUp" data-tour="@TutorialRegions.ReadLookup" @onclick="LookUpAsync">
                @T[ReadText.LookUpButton]
            </button>
        </section>

        @if (lookup.Message is not null)
        {
            <div class="alert alert-warning mt-3">@T[lookup.Message]</div>
        }

        @if (lookup.Manifest is { } manifest)
        {
            <section class="xf-card" data-tour="@TutorialRegions.ReadResult">
                <p class="mb-1">@(manifest.Manifest.Name ?? T[ReadText.NoName])</p>
                <p class="mb-1">@T[UiText.Of(CommonText.Bytes, ("count", manifest.Manifest.Size))]</p>
                <p class="mb-1">@T[UiText.Of(ReadText.ReadTime, ("duration", DurationText.Of(lookup.ReadDuration!.Value)))]</p>
                <p class="mb-1">@manifest.Manifest.Type</p>
                <p class="mb-1">@Html(UiText.Of(ReadText.WrittenBy, ("writer", manifest.Writer)), ("writer", "code"))</p>
                <p class="mb-1">@T[UiText.Of(ReadText.Blocks, ("count", manifest.Manifest.Blocks))]</p>
                <p class="mb-1">@Html(UiText.Of(ReadText.Node, ("url", lookup.NodeUrl ?? string.Empty)), ("url", "code"))</p>
            </section>

            <button type="button" class="btn btn-primary" disabled="@(!lookup.CanRead)" data-tour="@TutorialRegions.ReadRead" @onclick="StartRead">
                @T[ReadText.ReadButton]
            </button>
        }
    </div>
}

@code {
    /// <summary>
    /// How often this screen forces a render while a read may be progressing. Matches Shell.razor's
    /// and Publish.razor's own poll -- see their own remarks on why every poller in this application
    /// agrees on the interval.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly ScreenLifetime _lifetime = new();
    private Timer? _pollTimer;
    private bool _disposed;

    protected override void OnInitialized() =>
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);

    private void OnPollTick(object? state)
    {
        // Same disposal discipline as Shell.razor's and Publish.razor's own pollers: Timer.Dispose
        // does not wait for a callback already running on a thread-pool thread, so _disposed is
        // checked inside the delegate the renderer's own dispatcher runs, which orders that check
        // against Dispose().
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            StateHasChanged();
        });
    }

    private Task LookUpAsync() => Model.LookUpAsync(_lifetime.Token);

    // ReadModel.StartRead reads its own lookup, starts the read and only then empties the link box,
    // so the result of the previous read stays above it until this click replaces it.
    private void StartRead() => Model.StartRead(Run);

    private void Cancel() => Run.Cancel();

    private Task SaveAsync() => Run.SaveAsync(_lifetime.Token);

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason Shell.razor's own Dispose explains.
        _disposed = true;
        _pollTimer?.Dispose();
        _lifetime.End();
    }
}
