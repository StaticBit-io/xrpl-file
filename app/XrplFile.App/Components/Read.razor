@implements IDisposable
@inject ReadModel Model
@inject ReadRun Run

@* Design 4.1 and 4.2: the Read tab. It draws exactly one of four things, and which one is entirely
   Snapshot's and Model's own decision -- this markup only names the branch, never computes it. A
   running read is its own branch (progress and Cancel); Succeeded, Failed and Cancelled share a
   second branch, selected by Snapshot.IsFinished rather than by comparing State against three named
   values here, the same way RunModel.IsFinished decides that question for Run.razor (design C2) --
   moved onto ReadSnapshot itself, since this screen has no wrapping model of its own the way
   Run.razor has RunModel, and every field on that shared branch still differs only in what it says:
   all three are "the read is over, offer a way back". The fourth branch is Idle, where Model itself
   decides between "no manifest yet" (Model.Manifest is null) and "a manifest with a Read button"
   (CanRead already folds in both the manifest and any message the lookup produced).

   A save that throws while the read itself succeeded leaves State at Succeeded with Failure set
   (ReadRun.SaveAsync never writes State) -- the Succeeded branch draws that sentence exactly like
   the Failed branch draws its own, because the only other control next to a silent failure here is
   Dismiss, which deletes the one copy of the file that was just read. The Save button is disabled
   while Snapshot.Saving is true, straight off the run: nothing destructive happens from a second
   click (SaveAsync's own generation guard, see its remarks), but a control is not left enabled for
   the duration of an operation this screen already knows is running.

   Snapshot is taken once, at the top of this render, into a local -- not read field by field -- for
   the same reason Run.razor takes RunModel.Capture() once: ReadRun runs the block loop on a
   background task this screen never awaits, so separate reads of State, BlocksDone and Failure could
   land on different instants of the same run and draw, for instance, a Cancel button over a result
   that already finished. Part C2 had to fix exactly that shape twice.

   The blocks-done and bytes-done progress uses the browser's own <progress> element with raw done/
   total values as its attributes rather than a computed percentage: ReadSnapshot carries no percent
   of its own (unlike RunView, whose Percent is PublicationRun's own computed field), and turning
   BlocksDone/BlocksTotal into a percentage here would be exactly the kind of decision this component
   is not supposed to make on its own.

   The one-second timer exists for the same reason as Publish.razor's and Shell.razor's own pollers:
   a run's Snapshot changes on a task this component never awaits, so nothing here repaints on
   progress without a render forced from outside it. Copied verbatim from Shell.razor's own poll, at
   the same interval and the same Timer/ScreenLifetime/_disposed shape, so every screen that
   polls agrees on when it looks again. *@

@{
    ReadSnapshot snapshot = Run.Snapshot;
}

@if (snapshot.State == ReadState.Running)
{
    <div class="xf-page">
        <h1 class="xf-title">Reading</h1>

        <section class="xf-card">
            <p>@snapshot.BlocksDone of @snapshot.BlocksTotal blocks</p>
            <progress class="w-100" value="@snapshot.BlocksDone" max="@snapshot.BlocksTotal"></progress>

            <p class="mt-3">@snapshot.BytesDone.ToString("N0") of @snapshot.BytesTotal.ToString("N0") bytes</p>
            <progress class="w-100" value="@snapshot.BytesDone" max="@snapshot.BytesTotal"></progress>
        </section>

        <div class="xf-actionbar">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </div>
}
else if (snapshot.IsFinished)
{
    <div class="xf-page">
        <h1 class="xf-title">Reading</h1>

        @if (snapshot.State == ReadState.Succeeded)
        {
            <div class="alert alert-success">
                <p class="mb-2">@(snapshot.Name is { } name ? $"Read \"{name}\" successfully." : "Read successfully.")</p>
                <button type="button" class="btn btn-outline-secondary" disabled="@snapshot.Saving" @onclick="SaveAsync">
                    Save&hellip;
                </button>
                @if (snapshot.Saved)
                {
                    <p class="mt-2 mb-0">Saved.</p>
                }
                @if (snapshot.Failure is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@snapshot.Failure</div>
                }
            </div>
        }
        else if (snapshot.State == ReadState.Failed)
        {
            <div class="alert alert-danger">@snapshot.Failure</div>
        }
        else
        {
            <div class="alert alert-secondary">Cancelled. Nothing was saved.</div>
        }

        <div class="xf-actionbar">
            <button type="button" class="btn btn-primary" @onclick="Dismiss">Dismiss</button>
        </div>
    </div>
}
else
{
    // Taken once, the same reason Snapshot is taken once at the top of this whole render (see the
    // block comment above): ReadModel.LookUpAsync publishes Parsed, Manifest, NodeUrl and Message
    // together from a thread-pool continuation, and reading them one property at a time here could
    // land on different instants of the same or different lookups.
    ReadLookupSnapshot lookup = Model.Snapshot;

    <div class="xf-page">
        <h1 class="xf-title">Read a file</h1>

        <section class="xf-card">
            <div class="mb-3">
                <label for="read-link" class="form-label">Link</label>
                <input id="read-link" class="form-control xf-mono" @bind="Model.Link" @bind:event="oninput" />
            </div>

            <button type="button" class="btn btn-outline-primary" disabled="@Model.LookingUp" @onclick="LookUpAsync">
                Look up
            </button>
        </section>

        @if (lookup.Message is not null)
        {
            <div class="alert alert-warning mt-3">@lookup.Message</div>
        }

        @if (lookup.Manifest is { } manifest)
        {
            <section class="xf-card">
                <p class="mb-1">@(manifest.Manifest.Name ?? "(no name)")</p>
                <p class="mb-1">@manifest.Manifest.Size.ToString("N0") bytes</p>
                <p class="mb-1">@manifest.Manifest.Type</p>
                <p class="mb-1">Written by <span class="xf-mono">@manifest.Writer</span></p>
                <p class="mb-1">@manifest.Manifest.Blocks block(s)</p>
                <p class="mb-1">Node: <span class="xf-mono">@lookup.NodeUrl</span></p>
            </section>

            <button type="button" class="btn btn-primary" disabled="@(!lookup.CanRead)" @onclick="StartRead">
                Read
            </button>
        }
    </div>
}

@code {
    /// <summary>
    /// How often this screen forces a render while a read may be progressing. Matches Shell.razor's
    /// and Publish.razor's own poll -- see their own remarks on why every poller in this application
    /// agrees on the interval.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly ScreenLifetime _lifetime = new();
    private Timer? _pollTimer;
    private bool _disposed;

    protected override void OnInitialized() =>
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);

    private void OnPollTick(object? state)
    {
        // Same disposal discipline as Shell.razor's and Publish.razor's own pollers: Timer.Dispose
        // does not wait for a callback already running on a thread-pool thread, so _disposed is
        // checked inside the delegate the renderer's own dispatcher runs, which orders that check
        // against Dispose().
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            StateHasChanged();
        });
    }

    private Task LookUpAsync() => Model.LookUpAsync(_lifetime.Token);

    // CanRead is what gates this button (disabled unless it is true), and CanRead is defined as
    // Manifest is not null && Message is null. That alone does not guarantee Parsed is set too --
    // LookUpAsync's "no node URL configured" refusal, for one, sets Message and returns with Parsed
    // set but Manifest still null, which CanRead already reads as false. What actually backs the
    // null-forgiving operators below is ordering, not pairing: LookUpAsync's finally only ever
    // assigns Manifest after it has already assigned Parsed (ReadModel.cs), so Manifest being non-null
    // is itself proof Parsed was set first. CanRead being true (Manifest is not null) therefore already
    // is the model's guarantee that Parsed is set too. Read through Model.Snapshot rather than
    // Model.Parsed/Model.Manifest separately, so this call sees the same lookup the button that
    // triggered it was drawn from, not two independent reads that could straddle a lookup that landed
    // in between.
    private void StartRead()
    {
        ReadLookupSnapshot lookup = Model.Snapshot;
        Run.Start(lookup.Parsed!, lookup.Manifest!);
    }

    private void Cancel() => Run.Cancel();

    private Task SaveAsync() => Run.SaveAsync(_lifetime.Token);

    private void Dismiss()
    {
        Run.Reset();
        Model.Reset();
    }

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason Shell.razor's own Dispose explains.
        _disposed = true;
        _pollTimer?.Dispose();
        _lifetime.End();
    }
}
