@implements IDisposable
@inject AccountsModel Model
@inject FundingModel FundingModel

@* Design 4.1: the throwaway-account list, and the three screens it opens into. Every word on a row
   comes from AccountRow -- label, address, network and, from its own Stage, exactly one of five
   lines this markup switches on but never derives. AccountStage.Unknown is its own line rather than
   folded into "the balance": AccountsModel's own remarks are explicit that a cached
   DeletableFromLedger is not an answer, and showing zero for a balance nobody has actually read
   would be a different lie in the other direction (design G8).

   AccountsModel.RefreshAsync only re-reads the vault -- no network -- so the list itself is always
   cheap to draw. Learning what a given row actually holds costs one connection, which is why that is
   a per-row "Check" button (RefreshFromLedgerAsync) rather than something this screen does for every
   row on its own; AccountsModel's own remarks on why opening one connection per row would make the
   list slower than useful.

   The one-second timer is copied from Shell.razor and Publish.razor -- same Timer /
   CancellationTokenSource / _disposed shape -- but its job here is narrower than either: it exists
   so that the funding screen's balance, which FundingModel only learns when asked, keeps updating
   while somebody is actually looking at it, without a button. Nothing else on this screen changes on
   its own, so the tick only calls FundingModel.RefreshAsync while the funding sub-screen is the one
   showing. *@

<div class="container py-3" style="max-width: 900px;">
    @switch (_view)
    {
        case SubView.List:
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">Accounts</h1>
                <button type="button" class="btn btn-primary" @onclick="() => _view = SubView.New">
                    New account
                </button>
            </div>

            @if (Model.Message is not null)
            {
                <div class="alert alert-warning">@Model.Message</div>
            }

            @if (Model.Rows.Count == 0)
            {
                <p>No throwaway accounts yet.</p>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Label</th>
                            <th>Address</th>
                            <th>Network</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AccountRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td><code>@row.Address</code></td>
                                <td>@row.Network</td>
                                <td>
                                    @switch (row.Stage)
                                    {
                                        case AccountStage.Unknown:
                                            <span class="text-muted">Not checked yet</span>
                                            break;

                                        case AccountStage.KeyOnly:
                                            <span>a key, no account yet</span>
                                            break;

                                        case AccountStage.Funded:
                                            @* Guaranteed non-null on this branch (AccountsModel only reaches Funded
                                               once a node has actually answered); the null-forgiving operator states
                                               that invariant rather than GetValueOrDefault() quietly standing in for
                                               an answer nobody gave, which is exactly the zero design G8 forbids. *@
                                            <span>@row.BalanceDrops!.Value.ToString("N0") drops</span>
                                            break;

                                        case AccountStage.Closable:
                                            <span>can be closed now</span>
                                            break;

                                        case AccountStage.Closed:
                                            @if (row.Closure is { } closure)
                                            {
                                                <span>
                                                    Closed &mdash; sent @closure.ArrivedDrops.ToString("N0") drops to
                                                    @closure.Destination
                                                </span>
                                            }
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (row.HasActions)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                    disabled="@Model.IsChecking(row.Reference)"
                                                    @onclick="() => CheckAsync(row.Reference)">
                                                Check
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary"
                                                    @onclick="() => OpenFunding(row.Reference)">
                                                Fund
                                            </button>
                                            <button type="button" class="btn btn-outline-danger"
                                                    @onclick="() => OpenClose(row.Reference)">
                                                Close
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            break;

        case SubView.New:
            <NewAccount OnDone="ReturnToListAsync" />
            break;

        case SubView.Funding:
            <Funding Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;

        case SubView.Close:
            <CloseAccount Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;
    }
</div>

@code {
    private enum SubView
    {
        List,
        New,
        Funding,
        Close,
    }

    /// <summary>How often this screen forces a render while the funding sub-screen may be waiting on
    /// money to arrive. Matches Shell.razor's own poll -- see that component's own remarks.</summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    private readonly CancellationTokenSource _cts = new();
    private Timer? _pollTimer;
    private bool _disposed;
    private bool _fundingPollInFlight;
    private SubView _view = SubView.List;
    private string? _activeReference;

    protected override async Task OnInitializedAsync()
    {
        await Model.RefreshAsync(_cts.Token);

        // Started only once the first refresh has run, matching Shell.razor's own reasoning: a tick
        // can then never race the first render.
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);
    }

    private void OnPollTick(object? state)
    {
        // Same disposal discipline as Shell.razor's own poll: Timer.Dispose does not wait for a
        // callback already running on a thread-pool thread, so _disposed is checked inside the
        // delegate the renderer's own dispatcher runs, which orders that check against Dispose().
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            // FundingModel.RefreshAsync opens a ledger connection and can outlast one second
            // against a slow node; without this guard, a tick that fires while the previous one is
            // still awaiting would start a second connection racing the first one's writes to the
            // same fields, and a third would stack on top of that. Only one refresh is ever allowed
            // in flight -- a tick that finds one already running simply redraws this render's own
            // state and waits for the next.
            //
            // FundingModel.CurrentReference == _activeReference guards a second race: a tick started
            // while THIS account's funding screen was open can still be in flight after somebody has
            // since backed out and opened a DIFFERENT account's funding screen. FundingModel itself
            // now refuses to apply a stale answer once its own CurrentReference has moved on (see its
            // own remarks), so this check is not what keeps the fields correct -- it is what keeps
            // this screen from starting a refresh for an account it is not even showing any more.
            if (_view == SubView.Funding && !_fundingPollInFlight
                && string.Equals(FundingModel.CurrentReference, _activeReference, StringComparison.Ordinal))
            {
                _fundingPollInFlight = true;
                try
                {
                    await FundingModel.RefreshAsync(_cts.Token);
                }
                catch (OperationCanceledException)
                {
                    // Dispose() cancels _cts while this tick may be mid-await -- the ordinary way
                    // this screen is ever left, on this tab above all, not a fault to surface.
                    return;
                }
                finally
                {
                    _fundingPollInFlight = false;
                }
            }

            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void OpenFunding(string reference)
    {
        _activeReference = reference;
        _view = SubView.Funding;
    }

    private void OpenClose(string reference)
    {
        _activeReference = reference;
        _view = SubView.Close;
    }

    private async Task CheckAsync(string reference)
    {
        // Model.IsChecking(reference) flips to true synchronously, inside RefreshFromLedgerAsync,
        // before that method's own first await -- capturing the Task and rendering once before
        // awaiting it is what makes the button's disabled state visible for the whole call rather
        // than only after it finishes.
        Task refresh = Model.RefreshFromLedgerAsync(reference, _cts.Token);
        StateHasChanged();
        await refresh;
        StateHasChanged();
    }

    private async Task ReturnToListAsync()
    {
        _activeReference = null;
        _view = SubView.List;
        await Model.RefreshAsync(_cts.Token);
    }

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason Shell.razor's own Dispose explains.
        _disposed = true;
        _pollTimer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
}
