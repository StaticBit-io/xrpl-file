@implements IDisposable
@inject AccountsModel Model
@inject VaultListModel VaultList
@inject DeleteKeyModel DeleteModel

@* Design 4.1 and 6: every account the vault holds, in two sections -- the throwaway accounts this
   application generated, and the keys the person imported -- and the screens each row opens into.
   The two sections differ in what they are for and nothing else: both read their balance, check,
   fund and close the same way (an account made outside the application and imported to publish with
   is closed here too; CloseAccount warns once more for an imported one), and both carry the key
   actions Reveal, Export and Delete, which used to live on a tab of their own. Which section a row
   is in comes from AccountsModel (ThrowawayRows / ImportedRows), not from this markup.

   Damage found when the vault was opened is shown by the Damage panel above the sections, read from
   VaultListModel exactly as the key list used to; a damaged entry has no readable address, label or
   kind, so it has no row here and the panel is where it is named.

   Every word on a row comes from AccountRow -- label, address, network and, from its own Stage, exactly one of five
   lines this markup switches on but never derives. AccountStage.Unknown is its own line rather than
   folded into "the balance": AccountsModel's own remarks are explicit that a cached
   DeletableFromLedger is not an answer, and showing zero for a balance nobody has actually read
   would be a different lie in the other direction (design G8).

   AccountsModel.RefreshAsync only re-reads the vault -- no network -- so the list itself is always
   cheap to draw, and draws first. The list then reads every row once on open, one connection per
   network (RefreshAllFromLedgerAsync), without holding up that first draw: each row says "Checking…"
   in its Balance cell until its answer lands. The per-row "Check" button (RefreshFromLedgerAsync)
   stays for a retry after a read that failed, and for a fresh reading later. Leaving the screen
   ends the reads (ScreenLifetime), and nothing is drawn after that.

   The timer is copied from Shell.razor and Publish.razor -- same Timer / ScreenLifetime /
   _disposed shape -- and, like Publish.razor's, only redraws: the countdown on a row ("about 14
   minutes") is computed from the clock each time it renders. Asking the node again for the funding
   sub-screen's balance is not done here: Funding.razor polls for itself every ten seconds and redraws
   itself when the answer lands. This tick used to refresh FundingModel as well, but it redrew only
   this component, and Funding's parameters never change so Blazor did not re-render it -- a balance
   that arrived stayed invisible. The interval is five seconds rather than one because a countdown
   in minutes gains nothing from a faster redraw. *@

<div class="xf-page @(_view == SubView.List ? "xf-page-wide" : null)">
    @switch (_view)
    {
        case SubView.List:
            <div class="xf-page-head">
                <h1 class="xf-title">@T[AccountsText.Title]</h1>
                <div class="xf-page-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _view = SubView.AddKey">
                        @T[AccountsText.ImportKeyButton]
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => _view = SubView.New">
                        @T[AccountsText.NewAccountButton]
                    </button>
                </div>
            </div>

            @if (Model.Message is not null)
            {
                <div class="alert alert-warning">@T[Model.Message]</div>
            }

            @if (VaultList.IsDegraded)
            {
                <Damage OnChanged="StateHasChanged" />
            }

            @Section(AccountsText.PublishingTitle,
                AccountsText.PublishingDescription,
                AccountsText.PublishingEmpty,
                Model.ThrowawayRows)

            @Section(AccountsText.KeysTitle,
                AccountsText.KeysDescription,
                AccountsText.KeysEmpty,
                Model.ImportedRows)

            @if (_pendingDeleteRow is { } pending)
            {
                @* A dialog rather than a banner under the list: the question is about one row, and a
                   banner at the foot of a long list appears where nobody is looking. *@
                <div class="xf-dialog-backdrop">
                    <div class="xf-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title"
                         @onkeydown="OnDialogKey">
                        <h2 id="delete-title">@T[UiText.Of(AccountsText.DeleteTitle, ("label", pending.Label))]</h2>
                        <p>
                            @Html(UiText.Of(AccountsText.DeleteIntro, ("address", pending.Address)), ("address", "code"))
                        </p>
                        @if (_deleteWarning is { NeverExported: true })
                        {
                            <div class="alert alert-danger">
                                @T[AccountsText.DeleteNeverExported]
                            </div>
                        }
                        @if (_deleteProblem is { } deleteProblem)
                        {
                            <div class="alert alert-warning">@T[deleteProblem]</div>
                        }
                        <div class="xf-dialog-actions">
                            <button type="button" class="btn btn-outline-secondary" disabled="@_busy"
                                    @ref="_dialogCancel" @onclick="CancelDelete">
                                @T[CommonText.Cancel]
                            </button>
                            <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">
                                @T[AccountsText.DeleteKeyButton]
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (_deleteProblem is { } prepareProblem)
            {
                @* A failed preparation leaves no pending row, so the dialog above cannot carry it. *@
                <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
                    <span>@T[prepareProblem]</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">@T[AccountsText.DismissButton]</button>
                </div>
            }
            break;

        case SubView.New:
            <NewAccount OnDone="ReturnToListAsync" />
            break;

        case SubView.AddKey:
            <AddKey OnDone="ReturnToListAsync" />
            break;

        case SubView.Export:
            <ExportKey Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;

        case SubView.Reveal:
            <RevealSeed Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;

        case SubView.Funding:
            <Funding Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;

        case SubView.Close:
            <CloseAccount Reference="@(_activeReference!)" OnBack="ReturnToListAsync" />
            break;
    }
</div>

@code {
    private enum SubView
    {
        List,
        New,
        AddKey,
        Export,
        Reveal,
        Funding,
        Close,
    }

    /// <summary>
    /// One section of the list: a heading, one line saying what its accounts are, then the rows or
    /// its own empty-state line. Both sections go through here so they cannot drift apart in columns
    /// or actions; their differences are the text passed in and the rows the model sorted into them.
    /// </summary>
    private RenderFragment Section(TextId title, TextId description, TextId emptyText, IReadOnlyList<AccountRow> rows) =>
        @<section class="xf-section" aria-label="@T[title]">
            <div class="xf-section-head">
                <h2>@T[title]</h2>
                <p>@T[description]</p>
            </div>

            @if (rows.Count == 0)
            {
                <p class="xf-empty">@T[emptyText]</p>
            }
            else
            {
                <div class="xf-card xf-list">
                    <ul>
                        @* Column names for sighted readers; each cell's own content already says what
                           it is to a screen reader (an address, an amount, a status), so the row is hidden
                           from assistive technology rather than read as a fake list item. *@
                        <li class="xf-account xf-account-head" aria-hidden="true">
                            <span>@T[AccountsText.ColumnAccount]</span>
                            <span>@T[AccountsText.ColumnNetwork]</span>
                            <span>@T[AccountsText.ColumnBalance]</span>
                            <span>@T[AccountsText.ColumnStatus]</span>
                        </li>
                        @foreach (AccountRow row in rows)
                        {
                            <li class="xf-account">
                                <div class="xf-account-id">
                                    <div class="xf-account-name">
                                        <span>@row.Label</span>
                                        @if (row.NeedsExporting)
                                        {
                                            <span class="xf-tag xf-tag-danger" title="@T[AccountsText.NotExportedHint]">
                                                @T[AccountsText.NotExportedTag]
                                            </span>
                                        }
                                    </div>
                                    <code class="xf-mono xf-account-address" title="@row.Address">@row.Address</code>
                                </div>

                                <div class="xf-account-net">
                                    <span class="xf-net @(row.Network == "mainnet" ? "is-mainnet" : null)">@row.Network</span>
                                </div>

                                @{ UiText? balance = Model.BalanceTextOf(row); }
                                <div class="xf-account-balance @(balance is null || Model.IsChecking(row.Reference) || row.CheckFailed ? "is-unread" : null)">
                                    @(balance is null ? "—" : T[balance])
                                </div>

                                <div class="xf-account-status">
                                    @if (Model.ShowsStatus(row))
                                    {
                                        @StatusOf(row)
                                    }
                                </div>

                                <div class="xf-account-actions">
                                    @if (row.HasActions)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => OpenFunding(row.Reference)">
                                            @T[AccountsText.FundButton]
                                        </button>
                                    }
                                    @RowMenu(row)
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>;

    /// <summary>
    /// The row's stage as one short status and, where the stage has one, a detail line under it. The
    /// words are fixed per stage; the numbers come from the row (design G8: nothing here derives a
    /// balance or a ledger the model did not read).
    /// </summary>
    private RenderFragment StatusOf(AccountRow row) => row.Stage switch
    {
        AccountStage.Unknown => @<span class="xf-status">@T[Model.UnknownStatusTextOf(row) ?? AccountsText.StatusNotRead]</span>,
        AccountStage.KeyOnly => @<span class="xf-status">@T[AccountsText.StatusNotOnLedger]</span>,
        @* Funded is only reached once a node answered, and DeletableFromLedger and LedgersRemaining are
           set together by that same read, so both are there; the null-forgiving operator states that
           rather than letting a default stand in for an answer nobody gave (design G8). *@
        AccountStage.Funded => @<span>
            <span class="xf-status is-waiting">@T[UiText.Of(AccountsText.StatusClosableIn, ("time", row.TimeRemainingDescription!))]</span>
            <small>@T[UiText.Of(AccountsText.StatusAtLedger, ("ledger", row.DeletableFromLedger!.Value), ("remaining", row.LedgersRemaining!.Value))]</small>
        </span>,
        AccountStage.Closable => @<span class="xf-status is-ready">@T[AccountsText.StatusReadyToClose]</span>,
        AccountStage.Closed => @<span>
            <span class="xf-status">@T[AccountsText.StatusClosed]</span>
            @if (row.Closure is { } closure)
            {
                <small>@Html(UiText.Of(AccountsText.StatusClosedSent, ("amount", new XrpAmount(closure.ArrivedDrops)), ("destination", closure.Destination)), ("destination", "code"))</small>
            }
        </span>,
        _ => @<span></span>,
    };

    /// <summary>
    /// Everything a row can do besides funding, behind one button: a row of six buttons wrapped and
    /// crowded the list, and the destructive two now sit apart from the rest, after a separator.
    /// One menu is open at a time; a click outside it or Escape closes it.
    /// </summary>
    private RenderFragment RowMenu(AccountRow row) =>
        @<div class="xf-menu" @onkeydown="OnMenuKey">
            <button type="button" class="xf-icon-btn" aria-haspopup="menu"
                    aria-expanded="@(_menuFor == row.Reference ? "true" : "false")"
                    aria-label="@(T[UiText.Of(AccountsText.MoreActionsFor, ("label", row.Label))])"
                    @onclick="() => ToggleMenu(row.Reference)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
            </button>
            @if (_menuFor == row.Reference)
            {
                <div class="xf-menu-backdrop" @onclick="CloseMenu"></div>
                <div class="xf-menu-list" role="menu" tabindex="-1" @ref="_menuFirst" aria-label="@(T[UiText.Of(AccountsText.ActionsFor, ("label", row.Label))])">
                    @if (row.HasActions)
                    {
                        <button type="button" role="menuitem" class="xf-menu-item"
                                disabled="@Model.IsChecking(row.Reference)"
                                @onclick="() => FromMenu(() => CheckAsync(row.Reference))">
                            @T[AccountsText.MenuCheckBalance]
                        </button>
                    }
                    <button type="button" role="menuitem" class="xf-menu-item"
                            @onclick="() => FromMenu(() => OpenReveal(row.Reference))">
                        @T[AccountsText.MenuRevealSecret]
                    </button>
                    <button type="button" role="menuitem" class="xf-menu-item"
                            disabled="@VaultList.WritesAreRefused"
                            @onclick="() => FromMenu(() => OpenExport(row.Reference))">
                        @T[AccountsText.MenuExportKey]
                    </button>
                    <div class="xf-menu-sep" role="separator"></div>
                    @if (row.HasActions)
                    {
                        <button type="button" role="menuitem" class="xf-menu-item is-danger"
                                @onclick="() => FromMenu(() => OpenClose(row.Reference))">
                            @T[AccountsText.MenuCloseAccount]
                        </button>
                    }
                    @* The key actions stay on a closed account: its seed still controls an address
                       that can be funded back into existence. *@
                    <button type="button" role="menuitem" class="xf-menu-item is-danger"
                            disabled="@VaultList.WritesAreRefused"
                            @onclick="() => FromMenu(() => PrepareDeleteAsync(row))">
                        @T[AccountsText.MenuDeleteKey]
                    </button>
                </div>
            }
        </div>;

    private string? _menuFor;
    private ElementReference _menuFirst;
    private ElementReference _dialogCancel;
    private bool _focusMenu;
    private bool _focusDialog;

    private void ToggleMenu(string reference)
    {
        _menuFor = _menuFor == reference ? null : reference;
        _focusMenu = _menuFor is not null;
    }

    private void CloseMenu() => _menuFor = null;

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _menuFor = null;
    }

    private void OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_busy) CancelDelete();
    }

    private async Task FromMenu(Action action)
    {
        _menuFor = null;
        action();
        await Task.CompletedTask;
    }

    private async Task FromMenu(Func<Task> action)
    {
        _menuFor = null;
        await action();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus moves into what just opened, so a keyboard user lands in the menu or on the dialog's
        // safe button instead of behind the backdrop.
        if (_focusMenu && _menuFor is not null)
        {
            _focusMenu = false;
            try { await _menuFirst.FocusAsync(); } catch (InvalidOperationException) { }
        }

        if (_focusDialog && _pendingDeleteRow is not null)
        {
            _focusDialog = false;
            try { await _dialogCancel.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }

    /// <summary>How often this screen forces a render so the countdown on its rows moves. See the
    /// remarks at the top of this file for why this differs from Shell.razor's and Publish.razor's own interval.</summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

    private readonly ScreenLifetime _lifetime = new();
    private Timer? _pollTimer;
    private bool _disposed;
    private SubView _view = SubView.List;
    private string? _activeReference;
    private AccountRow? _pendingDeleteRow;
    private DeleteWarning? _deleteWarning;
    private UiText? _deleteProblem;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await RefreshVaultAsync();

        // The refresh swallows a vault failure rather than honouring the token, so a screen left
        // (or locked away) while it ran gets here after Dispose, which found no timer to stop yet.
        if (_disposed) return;

        // Not awaited: the list draws as soon as the vault has answered, and the balances arrive
        // into it afterwards.
        _ = ReadBalancesAsync();

        // Started only once the first refresh has run, matching Shell.razor's own reasoning: a tick
        // can then never race the first render.
        _pollTimer = new Timer(OnPollTick, state: null, PollInterval, PollInterval);
    }

    private void OnPollTick(object? state)
    {
        // Same disposal discipline as Shell.razor's own poll: Timer.Dispose does not wait for a
        // callback already running on a thread-pool thread, so _disposed is checked inside the
        // delegate the renderer's own dispatcher runs, which orders that check against Dispose().
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Re-reads the vault for both models: the accounts list, and the damage panel's own view of the
    /// same vault. The list swallows a vault failure into its Message; the damage read is allowed to
    /// fail the same quiet way, since the list already says why.
    /// </summary>
    private async Task RefreshVaultAsync()
    {
        await Model.RefreshAsync(_lifetime.Token);

        try
        {
            await VaultList.RefreshAsync(_lifetime.Token);
        }
        catch (VaultException)
        {
        }
    }

    private void OpenReveal(string reference)
    {
        _activeReference = reference;
        _view = SubView.Reveal;
    }

    private void OpenExport(string reference)
    {
        _activeReference = reference;
        _view = SubView.Export;
    }

    private void OpenFunding(string reference)
    {
        _activeReference = reference;
        _view = SubView.Funding;
    }

    private void OpenClose(string reference)
    {
        _activeReference = reference;
        _view = SubView.Close;
    }

    private async Task CheckAsync(string reference)
    {
        // Model.IsChecking(reference) flips to true synchronously, inside RefreshFromLedgerAsync,
        // before that method's own first await -- capturing the Task and rendering once before
        // awaiting it is what makes the button's disabled state visible for the whole call rather
        // than only after it finishes.
        Task refresh = Model.RefreshFromLedgerAsync(reference, _lifetime.Token);
        StateHasChanged();
        await refresh;
        StateHasChanged();
    }

    private async Task ReturnToListAsync()
    {
        _activeReference = null;
        _view = SubView.List;
        await RefreshVaultAsync();

        // What a funding or a closing changed shows in the balances; a row a read is still busy
        // with is skipped by the model, not read twice.
        _ = ReadBalancesAsync();
    }

    private async Task PrepareDeleteAsync(AccountRow row)
    {
        _deleteProblem = null;
        try
        {
            _deleteWarning = await DeleteModel.PrepareAsync(row.Reference, _lifetime.Token);
            _pendingDeleteRow = row;
            _focusDialog = true;
        }
        catch (VaultException ex)
        {
            _pendingDeleteRow = null;
            _deleteWarning = null;
            _deleteProblem = VaultErrorMessages.For(ex.Error);
        }
    }

    private void CancelDelete()
    {
        _pendingDeleteRow = null;
        _deleteWarning = null;
        _deleteProblem = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeleteRow is not { } pending || _busy)
        {
            return;
        }

        // A problem from an earlier attempt would otherwise outlive a delete that then succeeds.
        _deleteProblem = null;
        _busy = true;
        StateHasChanged();
        try
        {
            await DeleteModel.DeleteAsync(pending.Reference, _lifetime.Token);
            _pendingDeleteRow = null;
            _deleteWarning = null;
            await RefreshVaultAsync();
        }
        catch (VaultException ex)
        {
            _deleteProblem = VaultErrorMessages.For(ex.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReadBalancesAsync()
    {
        try
        {
            await Model.RefreshAllFromLedgerAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.Token.IsCancellationRequested)
        {
            // The person left the screen; the model has already cleared every row's checking state.
            // A cancellation from anywhere else is a read that failed, which the model reports itself.
            return;
        }

        // Dispose can run while this was awaiting; a render after it would touch a gone component.
        await InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        // Set before the timer is disposed, for the reason Shell.razor's own Dispose explains.
        _disposed = true;
        _pollTimer?.Dispose();
        _lifetime.End();
    }
}
