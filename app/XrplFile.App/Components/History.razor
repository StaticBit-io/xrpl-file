@implements IDisposable
@inject HistoryModel Model
@inject ReadModel ReadModel
@inject ReadRun ReadRun
@inject ShellModel Shell

@* Design 4.5 and design 12. Every record and every word is HistoryModel's own; the sentence below
   about forgetting and clearing only changing this local list is fixed copy, not something computed
   from the model, so it stays even when there is nothing to forget yet.

   The Read button puts away whatever an earlier read left behind, hands the row's link to
   ReadModel, and only then switches the shell to the Read tab -- that ordering, not this markup, is
   what makes the tab open with the row's own link and manifest rather than a previous read's
   finished result. ReadRun is a singleton that keeps its terminal state until something clears it
   (design H6), so without the reset this button could switch to a screen showing an earlier read's
   success panel, Save button and all, still wired to that earlier read's own temporary file. The
   reset itself is ReadRun.Reset's own decision, not this markup's: it already no-ops while a read is
   genuinely running (Linux-tested in ReadRunTests, "Resetting a run that is still going changes
   nothing"), which is the right behaviour for that case -- a running read must not be discarded
   silently. Which tab exists (AppTab.Read) and what a link is were both settled in Tasks 3 and 5;
   this is assignment and two calls, not a decision. *@

<div class="xf-page xf-page-wide">
    <div class="xf-page-head">
        <h1 class="xf-title">Published files</h1>
        @if (Model.Records.Count > 0)
        {
            <div class="xf-page-actions">
                <button type="button" class="btn btn-outline-danger" @onclick="Clear">Clear list</button>
            </div>
        }
    </div>

    @if (Model.Records.Count > 0)
    {
        <p class="xf-lede">
            Forgetting or clearing only changes this list on this device. Every file is already in the
            ledger, and any link you kept elsewhere still works.
        </p>
    }

    @if (Model.Message is not null)
    {
        <div class="alert alert-warning">@Model.Message</div>
    }

    @if (Model.Records.Count == 0)
    {
        <p class="xf-empty">Nothing published yet. Files you publish from this device appear here with their links.</p>
    }
    else
    {
        <div class="xf-card xf-list">
            <ul>
                @foreach (PublicationRecord record in Model.Records)
                {
                    <li class="xf-record">
                        <div class="xf-record-id">
                            <span class="xf-file-name">@record.Name</span>
                            @if (record.Payer is { } payer)
                            {
                                <small class="xf-muted">Paid by <span class="xf-mono">@payer</span></small>
                            }
                        </div>
                        <div class="xf-record-net">
                            <span class="xf-net @(record.Network == "mainnet" ? "is-mainnet" : null)">@record.Network</span>
                        </div>
                        <code class="xf-mono xf-record-link" title="@record.Link">@record.Link</code>
                        <div class="xf-record-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(record)">
                                Copy link
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Read(record)">
                                Open
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Forget(record)">
                                Forget
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    private readonly ScreenLifetime _lifetime = new();

    protected override void OnInitialized() => Model.Refresh();

    private Task CopyAsync(PublicationRecord record) => Model.CopyLinkAsync(record, _lifetime.Token);

    private void Forget(PublicationRecord record) => Model.Forget(record);

    private void Read(PublicationRecord record)
    {
        ReadRun.Reset();
        ReadModel.Link = record.Link;
        Shell.Show(AppTab.Read);
    }

    private void Clear() => Model.Clear();

    public void Dispose()
    {
        _lifetime.End();
    }
}
