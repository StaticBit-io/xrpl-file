@implements IDisposable
@inject VaultListModel Model

@* Design 6, "Damage": names the entries, keeps the intact ones visible elsewhere, and only offers
   the acknowledgement while WritesAreRefused is true. Both facts are read straight from the model on
   every render, never cached here -- showing a panel because the model says damage exists is
   displaying; deciding that damage exists already happened in VaultListModel.RefreshAsync. The
   acknowledge button is the one human act design 6 asks for: a press with the list in front of the
   person, never anything that calls AcknowledgeDamageAsync on its own. *@

<div class="alert alert-warning" role="alert">
    <h2 class="h5">@T[VaultText.DamageTitle]</h2>
    <p>
        @T[VaultText.DamageIntro]
    </p>
    <ul class="mb-2">
        @foreach (KeyRow row in Model.Rows.Where(row => row.IsDamaged))
        {
            <li><code class="xf-mono">@row.Reference</code></li>
        }
    </ul>

    @if (Model.WritesAreRefused)
    {
        <p>
            @T[VaultText.DamageWritesRefused]
        </p>
        <button type="button" class="btn btn-outline-warning" disabled="@_busy" @onclick="AcknowledgeAsync">
            @T[VaultText.DamageAcknowledge]
        </button>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly ScreenLifetime _lifetime = new();
    private bool _busy;

    private async Task AcknowledgeAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            await Model.AcknowledgeDamageAsync(_lifetime.Token);
        }
        finally
        {
            _busy = false;
        }

        await OnChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _lifetime.End();
    }
}
