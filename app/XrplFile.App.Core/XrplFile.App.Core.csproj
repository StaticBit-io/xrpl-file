<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XrplFile.App.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- XrplClient, for the one class that actually opens a WebSocket: XrplConnectionFactory. -->
    <ProjectReference Include="..\..\src\XrplFile.Core\XrplFile.Core.csproj" />
    <ProjectReference Include="..\..\src\XrplFile.Keys\XrplFile.Keys.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xrpl" />
  </ItemGroup>
  <ItemGroup>
    <!-- One catalog per language; TextCatalog finds each by this exact name. -->
    <EmbeddedResource Include="Localization\Text\*.json" LogicalName="XrplFile.App.Core.Localization.Text.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XrplFile.App.Core.Tests" />
  </ItemGroup>
</Project>
