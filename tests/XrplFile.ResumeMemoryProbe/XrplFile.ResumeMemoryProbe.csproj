<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>XrplFile.ResumeMemoryProbe</RootNamespace>
    <!--
      The desktop application's collector, not the S27 probe's: workstation and concurrent are the
      runtime's defaults, which the application keeps, and what this probe measures is a resume as
      the application runs it.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XrplFile.Core\XrplFile.Core.csproj" />
    <ProjectReference Include="..\..\src\XrplFile.Keys\XrplFile.Keys.csproj" />
  </ItemGroup>
  <Import Project="..\..\app\DesktopGarbageCollection.props" />
</Project>
