# Cloudflare Pages: only the first matching rule applies, top-down. The docs say redirects are
# followed whether or not a static asset exists at the path, and a :placeholder matches any single
# segment, so the file-page rule below would also swallow /ru/index.html, /js/route.mjs and so on.
# Each two-segment folder of static files therefore gets a pass-through rule ABOVE it (a 200 rule to
# the same path serves the asset itself). build.mjs fails when a built file is not covered.
/ru/:file /ru/:file 200
/js/:file /js/:file 200
/css/:file /css/:file 200
/data/:file /data/:file 200
/fonts/:file /fonts/:file 200
/img/:file /img/:file 200

# The file page: /<network>/<HASH> (decimal NetworkIDs included) is one static page that reads the path.
/:network/:hash /file 200
/:network/:hash/ /file 200
